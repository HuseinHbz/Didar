NODE_ENV=development
PORT=4000
# iecp_app: DML only, no DDL — every running service uses this role, never
# iecp_migrator. See docs/database/README.md#roles--least-privilege.
DATABASE_URL="postgresql://iecp_app:change-me-app@localhost:5432/iecp?schema=public"
JWT_SECRET="change-me-in-every-real-environment"
CORS_ORIGIN="http://localhost:3000"

# identity module (Phase 004) — see src/modules/identity/README.md
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
# AES-256-GCM key for TwoFactorCredential.secretEncrypted — base64, must
# decode to exactly 32 bytes. This is a real, valid local-dev-only key (so
# `cp .env.example .env` boots without an extra step) — never reuse it
# anywhere real. Generate a fresh one per real environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="N041517DdY+ycXfgpfbZHJNomSdGyN0i+4cwrco0lq4="
