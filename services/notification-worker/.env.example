NODE_ENV=development
REDIS_URL="redis://localhost:6379"

# CP-017: SmsAdapter is real (Kavenegar) once SMS_API_KEY is set. Optional —
# unset is fine, the adapter falls back to the same stub behavior every
# earlier phase's dev/test/CI setup already relies on (see
# src/notifications/adapters/sms.adapter.ts's own doc comment).
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE=verify

# Telegram/WhatsApp remain stubs (CP-017 explicit non-goal — see ADR-014).
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=
