{
  "name": "iecp",
  "version": "0.1.0",
  "private": true,
  "description": "Didar — Iran Eyewear Commerce Platform (IECP) monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate": "pnpm validate:structure && pnpm typecheck && pnpm lint",
    "roadmap:audit": "node scripts/roadmap-audit.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
