{
  "name": "@iecp/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod validation schemas for the IECP monorepo.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@iecp/eslint-config": "workspace:*",
    "@iecp/tsconfig": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
