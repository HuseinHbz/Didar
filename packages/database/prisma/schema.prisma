// IECP database schema — Phase 1 foundation.
//
// Scope: this is the enterprise database FOUNDATION (per Phase 003's own
// title), covering the primary entities across all 11 domain schemas — not
// full coverage of every table docs/product/blueprint.md eventually wants.
// Deliberately deferred for a later pass: procurement/supplier management,
// retail/POS/appointments, full rule-engine promotions, the complete lens
// pricing engine. See docs/database/README.md for exactly what's in vs. out
// and why.
//
// Conventions (see docs/database/README.md for the full rationale):
//   - UUID primary keys everywhere (blueprint §58).
//   - Money is always BigInt (Rial, integer, blueprint §90) — never Float.
//   - "Lifecycle" entities (created, edited, eventually soft-deleted by a
//     human) get the full createdAt/updatedAt/deletedAt trio.
//   - Append-only records (a fact captured once, never edited) get
//     createdAt only — a fabricated updatedAt/deletedAt on an immutable log
//     row would be actively misleading, not extra compliance.
//   - Pure join tables get a composite PK and createdAt only.
//   - snake_case in Postgres (@@map/@map), camelCase/PascalCase in Prisma.
//   - One PostgreSQL schema per business domain (multiSchema, GA since
//     Prisma 6 — see the file-level note on the `schemas` line below).

generator client {
  provider = "prisma-client-js"
}

// NOTE: `schemas` must be a single-line array — Prisma 6.19.3's parser
// rejects a multi-line one here (confirmed the hard way in Phase 001; see
// git history). Order matches docs/database/README.md, not creation order.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "customer", "catalog", "commerce", "inventory", "marketing", "cms", "finance", "notification", "analytics", "system"]
}

// =============================================================================
// Shared enums (declared once, used across schemas; each still needs its own
// @@schema since Postgres enum types are schema-scoped)
// =============================================================================

enum NotificationChannel {
  SMS
  TELEGRAM
  WHATSAPP
  EMAIL
  PUSH
  IN_APP

  @@schema("notification")
}

// =============================================================================
// identity — users, credentials/sessions, OTP, RBAC (blueprint §5)
// =============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String    @unique
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions            UserSession[]
  roles               UserRole[]
  devices             UserDevice[]
  twoFactorCredential TwoFactorCredential?
  permissionOverrides UserPermissionOverride[]
  securityEvents      SecurityEvent[]

  @@map("users")
  @@schema("identity")
}

/// One row per browser/app install a user has logged in from (blueprint
/// §5/§56 `user_devices`, "Device Trust" for admin). Distinct from
/// UserSession: a device can accumulate many sessions over time (re-login
/// after a refresh token expires reuses the same device row via
/// `fingerprint`), and `trustedAt` persists across those logins.
model UserDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fingerprint String // hash of a client-supplied device signature (UA + platform + app-generated install id) — never the raw signature
  label       String? // e.g. "Ali's iPhone" — user-editable, not derived
  platform    String? // "ios" | "android" | "web" | ...
  trustedAt   DateTime? @map("trusted_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("user_devices")
  @@schema("identity")
}

/// Session/refresh-token tracking (blueprint §55/§56) — one row per issued
/// refresh token. `deviceId` links a session to the device it was issued
/// from; nullable because not every historical/edge-case login path is
/// guaranteed to resolve a device (e.g. a future server-to-server flow).
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@map("user_sessions")
  @@schema("identity")
}

enum TwoFactorMethod {
  TOTP

  @@schema("identity")
}

/// blueprint §55/§56 `user_two_factor` — one credential per user (only TOTP
/// implemented; modeled as an enum, not a bare boolean, so a second method
/// is an additive migration later, not a schema redesign). `secretEncrypted`
/// is AES-256-GCM ciphertext (see EncryptionService) — the raw TOTP secret
/// is never stored at rest. `recoveryCodesHashed` mirrors `password_hash`'s
/// convention: hashed, one-time-use, never stored or logged in the clear.
model TwoFactorCredential {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  method              TwoFactorMethod @default(TOTP)
  secretEncrypted     String          @map("secret_encrypted")
  recoveryCodesHashed String[]        @map("recovery_codes_hashed")
  enabled             Boolean         @default(false)
  verifiedAt          DateTime?       @map("verified_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor_credentials")
  @@schema("identity")
}

/// Mobile OTP (blueprint §56: primary auth mechanism). Append-only — a
/// consumed/expired code is never edited, only superseded by a new request.
model OtpRequest {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String // LOGIN | REGISTER | RESET_PASSWORD — kept as a string, not an enum, since new purposes are cheap to add and don't need a migration
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_requests")
  @@schema("identity")
}

/// blueprint §53 — roles form a tree via `parentId` (e.g. the blueprint's own
/// Admin → Commerce → Products example). A role's *effective* permissions are
/// its own `RolePermission` rows unioned with every ancestor's, resolved
/// recursively by PermissionResolver (services/api identity module) — the
/// database only stores the edges, not the resolved closure.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Role?            @relation("RoleToParent", fields: [parentId], references: [id])
  children    Role[]           @relation("RoleToParent")
  permissions RolePermission[]
  users       UserRole[]

  @@index([parentId])
  @@map("roles")
  @@schema("identity")
}

/// blueprint §53's fine-grained permission model. `key` (e.g.
/// "identity.users.view_contact") is the canonical identifier used
/// everywhere in code; `module`/`action` are the same string split into
/// queryable columns so an admin UI can render a module × action matrix
/// without parsing `key`. `module` is a free-form string, not an enum tied
/// to the 11 Postgres domain schemas — permissions are registered per
/// NestJS module as that module is built (see services/api's identity
/// module for what's registered so far), not pre-declared for domains that
/// don't have endpoints yet.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String
  action      String
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@unique([module, action])
  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

enum PermissionEffect {
  ALLOW
  DENY

  @@schema("identity")
}

/// blueprint §53's per-user exception example ("Product.Publish = NO" even
/// though the user's role would otherwise grant it). Resolved on top of the
/// role-derived permission set; DENY always wins over any role grant, ALLOW
/// grants something no assigned role does. Not a join table (no composite
/// PK) because `effect`/`reason`/`createdBy` are real per-row data, not just
/// an association.
model UserPermissionOverride {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect
  reason       String?
  createdBy    String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
  @@schema("identity")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_FAILED
  SESSION_REVOKED
  SESSION_REFRESHED
  API_KEY_CREATED
  API_KEY_REVOKED

  @@schema("identity")
}

/// blueprint §5/§55 `user_security_events` — the "Login Attempts / Failed
/// Login / Security Events" leg of the Security Center list. Append-only,
/// written alongside (not instead of) `system.AuditLog`: AuditLog is the
/// general-purpose "who changed what" record for any mutation across any
/// domain, this is identity-specific and always has a `type` from a fixed,
/// known set, which makes it cheap to query/alert on without parsing
/// `AuditLog.action` strings. `userId` is nullable — a failed login attempt
/// against a phone/email with no matching account still needs a row.
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  type      SecurityEventType
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
  @@schema("identity")
}

// =============================================================================
// customer — the person, their addresses/family, and their loyalty/wallet
// accounts (blueprint §6/§15/§32/§35, USPs #5-#6)
// =============================================================================

enum CustomerGender {
  MALE
  FEMALE
  OTHER

  @@schema("customer")
}

enum FamilyRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  OTHER

  @@schema("customer")
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  VIP

  @@schema("customer")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST

  @@schema("customer")
}

enum WalletTransactionType {
  CASHBACK
  REFUND
  GIFT
  CREDIT
  DEBIT
  EXPIRATION

  @@schema("customer")
}

model Customer {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @unique @map("user_id") @db.Uuid
  firstName  String          @map("first_name")
  lastName   String          @map("last_name")
  nationalId String?         @unique @map("national_id")
  birthDate  DateTime?       @map("birth_date") @db.Date
  gender     CustomerGender?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  addresses      CustomerAddress[]
  familyMembers  FamilyMember[]
  segments       CustomerSegmentMember[]
  loyaltyAccount LoyaltyAccount?
  walletAccount  WalletAccount?

  @@map("customers")
  @@schema("customer")
}

model CustomerAddress {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  label         String? // "خانه", "محل کار", ...
  recipientName String    @map("recipient_name")
  phone         String
  province      String
  city          String
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  postalCode    String?   @map("postal_code")
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
  @@schema("customer")
}

/// blueprint §15 — a family member is a lightweight profile, not necessarily
/// its own User/Customer account (a child may never log in themselves).
model FamilyMember {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  relation   FamilyRelation
  firstName  String         @map("first_name")
  lastName   String         @map("last_name")
  birthDate  DateTime?      @map("birth_date") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("family_members")
  @@schema("customer")
}

/// blueprint §70 — segments are admin-defined (e.g. "VIP", "Cart Abandoner");
/// membership is computed/assigned, not a fixed enum.
model CustomerSegment {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members CustomerSegmentMember[]

  @@map("customer_segments")
  @@schema("customer")
}

model CustomerSegmentMember {
  customerId String   @map("customer_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at")

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([customerId, segmentId])
  @@map("customer_segment_members")
  @@schema("customer")
}

/// blueprint §32 — points are a ledger (LoyaltyTransaction), not a single
/// mutable counter; pointsBalance here is a maintained cache of the sum.
model LoyaltyAccount {
  id            String      @id @default(uuid()) @db.Uuid
  customerId    String      @unique @map("customer_id") @db.Uuid
  pointsBalance Int         @default(0) @map("points_balance")
  tier          LoyaltyTier @default(BRONZE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
  @@schema("customer")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid()) @db.Uuid
  loyaltyAccountId String                 @map("loyalty_account_id") @db.Uuid
  type             LoyaltyTransactionType
  points           Int
  reason           String?
  createdAt        DateTime               @default(now()) @map("created_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId])
  @@map("loyalty_transactions")
  @@schema("customer")
}

/// blueprint §35/§116 — same ledger discipline as loyalty, in Rial.
model WalletAccount {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  balance    BigInt   @default(0)
  currency   String   @default("IRR")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet_accounts")
  @@schema("customer")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletAccountId String                @map("wallet_account_id") @db.Uuid
  type            WalletTransactionType
  amount          BigInt
  balanceAfter    BigInt                @map("balance_after")
  reference       String?
  createdAt       DateTime              @default(now()) @map("created_at")

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  @@index([walletAccountId])
  @@map("wallet_transactions")
  @@schema("customer")
}

// =============================================================================
// catalog — brands, categories, collections, products, variants, SKUs,
// attributes/filters, media (blueprint §7-§13). Phase 005 — see
// docs/adr/ADR-005-catalog-architecture.md for why variant and SKU are two
// different models (decision 1), why SEO/AR fields are typed JSON columns
// (decision 3), and why dynamic collections store a narrow rule bag instead
// of a general rule engine (decision 4).
// =============================================================================

enum ProductGender {
  MALE
  FEMALE
  UNISEX
  KIDS

  @@schema("catalog")
}

/// blueprint §7 / Phase 005 `business_context.product_domain`.
enum ProductType {
  EYEGLASSES
  SUNGLASSES
  COMPUTER_GLASSES
  READING_GLASSES
  CONTACT_LENSES
  OPTICAL_FRAME
  LENS
  ACCESSORY

  @@schema("catalog")
}

/// Product publication state machine (Phase 005 `product_lifecycle`),
/// enforced by ProductLifecycleStateMachine (domain layer) before it ever
/// reaches the database — see services/api/src/modules/catalog/README.md.
enum ProductLifecycleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@schema("catalog")
}

/// Simple on/off switch for merchandising entities that don't need the full
/// product publication workflow (brand, category, collection, variant).
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@schema("catalog")
}

/// DISCONTINUED is distinct from INACTIVE: a discontinued SKU stays
/// queryable (existing orders/inventory history still reference it) but can
/// never be reactivated for sale the way a merely-inactive one can.
enum SkuStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED

  @@schema("catalog")
}

enum CollectionType {
  MANUAL
  DYNAMIC

  @@schema("catalog")
}

/// Storage abstraction (ADR-005 decision 3) — the catalog domain never
/// imports a specific object-storage SDK; swapping providers is a new value
/// here plus a new infrastructure/storage adapter, not a schema change.
enum MediaProvider {
  LOCAL
  S3
  CDN

  @@schema("catalog")
}

enum MediaKind {
  IMAGE
  VIDEO
  MODEL_3D
  AR_ASSET

  @@schema("catalog")
}

enum MediaRole {
  PRIMARY
  GALLERY
  THUMBNAIL
  SWATCH
  VIDEO
  MODEL_3D

  @@schema("catalog")
}

enum MediaStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

model Brand {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  slug          String        @unique
  /// `{ "fa": "...", "en": "..." }` — see ADR-005 decision 3.
  localizedName Json?         @map("localized_name")
  description   String?
  logoMediaId   String?       @map("logo_media_id") @db.Uuid
  status        CatalogStatus @default(ACTIVE)
  sortOrder     Int           @default(0) @map("sort_order")
  /// title/metaDescription/canonicalUrl/ogImage/noIndex — see ADR-005 decision 3.
  seo           Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  logoMedia Media?    @relation("BrandLogo", fields: [logoMediaId], references: [id])
  products  Product[]

  @@index([status])
  @@map("brands")
  @@schema("catalog")
}

/// Self-referencing tree, unlimited depth (blueprint §10). `status` is the
/// active/inactive switch; `publishedAt` is the separate "is this browsable
/// on the storefront" gate the brief asks for (null = not published).
model Category {
  id            String        @id @default(uuid()) @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  name          String
  slug          String        @unique
  localizedName Json?         @map("localized_name")
  description   String?
  imageMediaId  String?       @map("image_media_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  status        CatalogStatus @default(ACTIVE)
  publishedAt   DateTime?     @map("published_at")
  seo           Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  parent     Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryToParent")
  imageMedia Media?     @relation("CategoryImage", fields: [imageMediaId], references: [id])
  products   Product[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
  @@schema("catalog")
}

/// Manual (explicit `CollectionProduct` membership) or dynamic (`rules`
/// evaluated at query time by CollectionRuleEvaluator — see ADR-005 decision
/// 4; not a general rule engine, a fixed filter shape).
model Collection {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  localizedName Json?          @map("localized_name")
  description   String?
  type          CollectionType @default(MANUAL)
  /// Only read when type = DYNAMIC: `{ brandId?, categoryId?, tags?, gender?, productType? }`.
  rules         Json?
  priority      Int            @default(0)
  startAt       DateTime?      @map("start_at")
  endAt         DateTime?      @map("end_at")
  status        CatalogStatus  @default(ACTIVE)
  publishedAt   DateTime?      @map("published_at")
  imageMediaId  String?        @map("image_media_id") @db.Uuid
  seo           Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  imageMedia Media?              @relation("CollectionImage", fields: [imageMediaId], references: [id])
  products   CollectionProduct[]

  @@index([type])
  @@index([status])
  @@map("collections")
  @@schema("catalog")
}

/// MANUAL collection membership, with its own admin-controlled sort order
/// independent of the product's own catalog position.
model CollectionProduct {
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
  @@schema("catalog")
}

/// The merchandising aggregate root. Not itself sellable/priced/inventoried
/// — see ProductVariant/ProductSku below (ADR-005 decision 1). Status is
/// ProductLifecycleStatus, driven only through ProductLifecycleStateMachine.
model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  productType       ProductType            @map("product_type")
  brandId           String                 @map("brand_id") @db.Uuid
  categoryId        String                 @map("category_id") @db.Uuid
  name              String
  slug              String                 @unique
  localizedName     Json?                  @map("localized_name")
  shortDescription  String?                @map("short_description")
  longDescription   String?                @map("long_description")
  /// Free-form spec sheet (varies hugely by productType — frame vs. contact
  /// lens), e.g. `{ "lensWidth": "52mm", "material": "acetate" }`.
  specifications    Json?
  tags              String[]               @default([])
  status            ProductLifecycleStatus @default(DRAFT)
  reviewedBy        String?                @map("reviewed_by") @db.Uuid
  approvedBy        String?                @map("approved_by") @db.Uuid
  approvedAt        DateTime?              @map("approved_at")
  publishedAt       DateTime?              @map("published_at")
  unpublishedAt     DateTime?              @map("unpublished_at")
  archivedAt        DateTime?              @map("archived_at")
  /// AR-readiness (Phase 005 `ar_readiness` — schema only, no AR engine).
  arModelMediaId    String?                @map("ar_model_media_id") @db.Uuid
  faceTryOnMetadata Json?                  @map("face_try_on_metadata")
  seo               Json?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")

  brand        Brand               @relation(fields: [brandId], references: [id])
  category     Category            @relation(fields: [categoryId], references: [id])
  arModelMedia Media?              @relation("ProductArModel", fields: [arModelMediaId], references: [id])
  variants     ProductVariant[]
  skus         ProductSku[]
  media        ProductMedia[]
  collections  CollectionProduct[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([productType])
  @@map("products")
  @@schema("catalog")
}

/// One product, many merchandising configurations (e.g. color × size —
/// blueprint §8). Carries the optical measurement/merchandising attributes;
/// deliberately has no price/cost/barcode — see ProductSku and ADR-005
/// decision 1. A variant can exist without a SKU yet (draft authoring
/// workflow); it cannot be sold until one exists.
model ProductVariant {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  label             String?
  color             String?
  colorHex          String?        @map("color_hex")
  size              String?
  frameShape        String?        @map("frame_shape")
  frameMaterial     String?        @map("frame_material")
  frameWidthMm      Int?           @map("frame_width_mm")
  bridgeWidthMm     Int?           @map("bridge_width_mm")
  templeLengthMm    Int?           @map("temple_length_mm")
  lensWidthMm       Int?           @map("lens_width_mm")
  fit               String?
  gender            ProductGender?
  style             String?
  /// Tag references into LensType.name / LensCoating.name — not an FK
  /// (a variant can list compatibility with lens options that are still
  /// lookup-table rows, see LensType's own doc comment).
  lensCompatibility String[]       @default([]) @map("lens_compatibility")
  isDefault         Boolean        @default(false) @map("is_default")
  status            CatalogStatus  @default(ACTIVE)
  sortOrder         Int            @default(0) @map("sort_order")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  product         Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             ProductSku?
  media           ProductMedia[]
  attributeValues ProductVariantAttributeValue[]

  @@index([productId])
  @@map("product_variants")
  @@schema("catalog")
}

/// The sellable/priced/inventoried unit (ADR-005 decision 1). Exactly one
/// SKU per variant this pass (`variantId` unique) — see that ADR's
/// "Deferred" section for why multi-SKU-per-variant isn't built yet. Cost
/// and base/compare-at price deliberately live on `finance.ProductPrice`,
/// not here — "pricing is its own domain, not a bare column" (that model's
/// own doc comment) applies to SKU exactly as it did to the old
/// `ProductVariant`. `finance.ProductPrice`/`PriceHistory` and
/// `inventory.InventoryItem` key off `id` here (as a plain, unenforced
/// cross-schema column — see docs/database/README.md's "Cross-schema
/// references are intentionally unenforced").
model ProductSku {
  id                 String    @id @default(uuid()) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  variantId          String    @unique @map("variant_id") @db.Uuid
  skuCode            String    @unique @map("sku_code")
  barcode            String?   @unique
  status             SkuStatus @default(ACTIVE)
  weightGrams        Int?      @map("weight_grams")
  lengthMm           Int?      @map("length_mm")
  widthMm            Int?      @map("width_mm")
  heightMm           Int?      @map("height_mm")
  /// Integer basis points (e.g. 900 = 9.00%) — same convention as
  /// `packages/types`' `Money.applyBasisPoints`, never a float.
  taxRateBasisPoints Int?      @map("tax_rate_basis_points")
  supplierRef        String?   @map("supplier_ref")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("product_skus")
  @@schema("catalog")
}

/// Attribute *definitions* (blueprint §9/§11: admin-defined, drives the
/// Dynamic Filter Engine without a Frontend/Backend redeploy) — for
/// open-ended tags the fixed ProductVariant columns don't cover.
model ProductAttribute {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique // e.g. "frame_shape"
  name          String // e.g. "شکل فریم"
  localizedName Json?    @map("localized_name")
  isFilterable  Boolean  @default(true) @map("is_filterable")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  values ProductAttributeValue[]

  @@map("product_attributes")
  @@schema("catalog")
}

model ProductAttributeValue {
  id             String   @id @default(uuid()) @db.Uuid
  attributeId    String   @map("attribute_id") @db.Uuid
  value          String // e.g. "Round"
  localizedValue Json?    @map("localized_value")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  attribute ProductAttribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("product_attribute_values")
  @@schema("catalog")
}

model ProductVariantAttributeValue {
  variantId        String   @map("variant_id") @db.Uuid
  attributeValueId String   @map("attribute_value_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attribute_values")
  @@schema("catalog")
}

/// Storage-agnostic media asset (ADR-005 decision 3). `provider` +
/// `storageKey` are the abstraction seam; nothing in this domain imports an
/// S3/CDN SDK directly. `kind = MODEL_3D | AR_ASSET` is the AR-readiness
/// hook (`Product.arModelMediaId`) — no AR engine reads it yet.
model Media {
  id         String        @id @default(uuid()) @db.Uuid
  provider   MediaProvider @default(LOCAL)
  storageKey String        @unique @map("storage_key")
  url        String
  kind       MediaKind
  mimeType   String        @map("mime_type")
  width      Int?
  height     Int?
  durationMs Int?          @map("duration_ms")
  checksum   String?
  altText    Json?         @map("alt_text")
  status     MediaStatus   @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  brandLogos       Brand[]        @relation("BrandLogo")
  categoryImages   Category[]     @relation("CategoryImage")
  collectionImages Collection[]   @relation("CollectionImage")
  arModelProducts  Product[]      @relation("ProductArModel")
  productMedia     ProductMedia[]

  @@index([kind])
  @@index([status])
  @@map("media")
  @@schema("catalog")
}

/// Attaches a Media asset to a product (`variantId = null`) or to one
/// specific variant (e.g. a colorway's own gallery). `onDelete: Restrict` on
/// `media` — a Media row in active use can't be silently deleted out from
/// under a product; it must be detached first (see Media's own doc comment).
model ProductMedia {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  variantId       String?   @map("variant_id") @db.Uuid
  mediaId         String    @map("media_id") @db.Uuid
  role            MediaRole @default(GALLERY)
  sortOrder       Int       @default(0) @map("sort_order")
  altTextOverride Json?     @map("alt_text_override")
  createdAt       DateTime  @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_media")
  @@schema("catalog")
}

/// blueprint §13 — minimal lookup tables only. The full lens configuration +
/// compatibility engine (index, coating combinations, pricing rules) is
/// deliberately out of scope for this foundation pass (still true as of
/// Phase 005 — see ADR-005 "Deferred").
model LensType {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  localizedName Json?    @map("localized_name")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("lens_types")
  @@schema("catalog")
}

model LensCoating {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  localizedName Json?    @map("localized_name")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("lens_coatings")
  @@schema("catalog")
}

// =============================================================================
// inventory — warehouses, stock ledger, reservations, transfers, counts
// (blueprint §23-§28; Phase 006 — see docs/adr/ADR-006-inventory-architecture.md)
// =============================================================================

enum WarehouseType {
  CENTRAL
  REGIONAL
  STORE
  DARK_STORE
  QUARANTINE

  @@schema("inventory")
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  CLOSED

  @@schema("inventory")
}

enum LocationType {
  RECEIVING
  PICKING
  STORAGE
  QUARANTINE
  DAMAGED
  RETURNS
  STAGING

  @@schema("inventory")
}

/// The stock-movement vocabulary — every `InventoryLedger` row has exactly
/// one of these. Phase 006 replaces Phase 003's smaller
/// `InventoryTransactionType` placeholder (PURCHASE/RELEASE/RETURN/... ) with
/// the brief's exact required set — see the migration's header comment for
/// the old→new value mapping used to carry existing rows forward.
enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE
  RESERVATION
  RESERVATION_RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_RECEIPT
  DAMAGE
  ADJUSTMENT
  COUNT_ADJUSTMENT
  QUARANTINE
  RELEASE_FROM_QUARANTINE
  MANUAL_CORRECTION

  @@schema("inventory")
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONVERTED
  EXPIRED
  CANCELLED

  @@schema("inventory")
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  PICKING
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@schema("inventory")
}

enum InventoryAdjustmentType {
  POSITIVE
  NEGATIVE

  @@schema("inventory")
}

enum StockCountStatus {
  PLANNED
  IN_PROGRESS
  COUNTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED

  @@schema("inventory")
}

model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  type      WarehouseType   @default(CENTRAL)
  status    WarehouseStatus @default(ACTIVE)
  address   String?
  timezone  String          @default("Asia/Tehran")
  capacity  Int?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  locations    WarehouseLocation[]
  items        InventoryItem[]
  thresholds   InventoryThreshold[]
  transfersOut StockTransfer[]       @relation("TransferSource")
  transfersIn  StockTransfer[]       @relation("TransferDestination")
  adjustments  InventoryAdjustment[]
  stockCounts  StockCount[]

  @@index([type])
  @@index([status])
  @@map("warehouses")
  @@schema("inventory")
}

/// A warehouse must have at least one location before it can hold stock —
/// see ADR-006 decision 1 for why `InventoryItem` is keyed at this
/// granularity rather than warehouse-level only.
model WarehouseLocation {
  id          String       @id @default(uuid()) @db.Uuid
  warehouseId String       @map("warehouse_id") @db.Uuid
  code        String
  name        String
  type        LocationType @default(STORAGE)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items         InventoryItem[]
  ledgerEntries InventoryLedger[]
  adjustments   InventoryAdjustment[]
  stockCounts   StockCount[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("warehouse_locations")
  @@schema("inventory")
}

/// blueprint §23 — quantity buckets are a maintained cache (see ADR-006
/// decision 2); `InventoryLedger` is the source of truth for *why* each one
/// is what it is. `availableQuantity = onHand - reserved - damaged -
/// quarantined - blocked`, recomputed and asserted by the domain layer
/// (`AvailableQuantityCalculator`) on every write, never trusted as
/// already-correct input. `version` supports optimistic-locking callers on
/// top of the row-level lock every mutation already takes (ADR-006 decision
/// 4). `productSkuId` (Phase 005 — see ADR-005 decision 1) is a plain,
/// unenforced cross-schema column into `catalog.product_skus` — see
/// docs/database/README.md's "Cross-schema references are intentionally
/// unenforced".
model InventoryItem {
  id                  String   @id @default(uuid()) @db.Uuid
  productSkuId        String   @map("product_sku_id") @db.Uuid
  warehouseId         String   @map("warehouse_id") @db.Uuid
  locationId          String   @map("location_id") @db.Uuid
  onHandQuantity      Int      @default(0) @map("on_hand_quantity")
  reservedQuantity    Int      @default(0) @map("reserved_quantity")
  availableQuantity   Int      @default(0) @map("available_quantity")
  inTransitQuantity   Int      @default(0) @map("in_transit_quantity")
  damagedQuantity     Int      @default(0) @map("damaged_quantity")
  quarantinedQuantity Int      @default(0) @map("quarantined_quantity")
  blockedQuantity     Int      @default(0) @map("blocked_quantity")
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  location      WarehouseLocation      @relation(fields: [locationId], references: [id])
  ledgerEntries InventoryLedger[]
  reservations  InventoryReservation[]

  @@unique([productSkuId, warehouseId, locationId])
  @@index([productSkuId])
  @@index([warehouseId])
  @@index([productSkuId, warehouseId])
  @@map("inventory_items")
  @@schema("inventory")
}

/// Low-stock thresholds — per SKU + warehouse, deliberately decoupled from
/// location (ADR-006 decision 6). Admin-configurable, never hardcoded.
model InventoryThreshold {
  id           String   @id @default(uuid()) @db.Uuid
  productSkuId String   @map("product_sku_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  reorderPoint Int      @default(0) @map("reorder_point")
  safetyStock  Int      @default(0) @map("safety_stock")
  minStock     Int?     @map("min_stock")
  maxStock     Int?     @map("max_stock")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productSkuId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_thresholds")
  @@schema("inventory")
}

/// blueprint §24/§27 — the append-only ledger, and the authoritative
/// movement history (ADR-006 decision 2). Never updated, never deleted.
/// `referenceType`/`referenceId` are deliberately polymorphic, not an FK —
/// the procurement/returns readiness seam (ADR-006 decision 9).
model InventoryLedger {
  id              String                @id @default(uuid()) @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  productSkuId    String                @map("product_sku_id") @db.Uuid
  warehouseId     String                @map("warehouse_id") @db.Uuid
  locationId      String                @map("location_id") @db.Uuid
  movementType    InventoryMovementType @map("movement_type")
  quantity        Int
  beforeOnHand    Int                   @map("before_on_hand")
  afterOnHand     Int                   @map("after_on_hand")
  beforeReserved  Int                   @map("before_reserved")
  afterReserved   Int                   @map("after_reserved")
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id") @db.Uuid
  reason          String?
  actorUserId     String?               @map("actor_user_id") @db.Uuid
  correlationId   String                @map("correlation_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")

  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  location      WarehouseLocation @relation(fields: [locationId], references: [id])

  @@index([inventoryItemId])
  @@index([productSkuId])
  @@index([warehouseId])
  @@index([referenceType, referenceId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("inventory_ledger")
  @@schema("inventory")
}

/// Transactional, row-lock-serialized, idempotency-key-protected — see
/// ADR-006 decisions 4-5. `sourceType`/`sourceId` are deliberately
/// polymorphic (cart, order, POS sale, home-try-on — none of which this
/// phase implements), matching the ledger's own reference pattern.
model InventoryReservation {
  id              String                     @id @default(uuid()) @db.Uuid
  productSkuId    String                     @map("product_sku_id") @db.Uuid
  warehouseId     String                     @map("warehouse_id") @db.Uuid
  locationId      String                     @map("location_id") @db.Uuid
  inventoryItemId String                     @map("inventory_item_id") @db.Uuid
  quantity        Int
  status          InventoryReservationStatus @default(ACTIVE)
  sourceType      String                     @map("source_type")
  sourceId        String                     @map("source_id") @db.Uuid
  idempotencyKey  String                     @unique @map("idempotency_key")
  expiresAt       DateTime?                  @map("expires_at")
  releasedAt      DateTime?                  @map("released_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([productSkuId, warehouseId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([expiresAt])
  @@map("inventory_reservations")
  @@schema("inventory")
}

/// Warehouse-to-warehouse (or store) stock movement — a real 9-state
/// machine (`TransferStateMachine`, domain layer), matching the brief's
/// exact status list.
model StockTransfer {
  id                     String              @id @default(uuid()) @db.Uuid
  referenceNumber        String              @unique @map("reference_number")
  sourceWarehouseId      String              @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String              @map("destination_warehouse_id") @db.Uuid
  status                 StockTransferStatus @default(DRAFT)
  requestedBy            String?             @map("requested_by") @db.Uuid
  approvedBy             String?             @map("approved_by") @db.Uuid
  dispatchedAt           DateTime?           @map("dispatched_at")
  receivedAt             DateTime?           @map("received_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  sourceWarehouse      Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  items                StockTransferItem[]

  @@index([status])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@map("stock_transfers")
  @@schema("inventory")
}

model StockTransferItem {
  id                 String   @id @default(uuid()) @db.Uuid
  transferId         String   @map("transfer_id") @db.Uuid
  productSkuId       String   @map("product_sku_id") @db.Uuid
  requestedQuantity  Int      @map("requested_quantity")
  approvedQuantity   Int?     @map("approved_quantity")
  dispatchedQuantity Int?     @map("dispatched_quantity")
  receivedQuantity   Int?     @map("received_quantity")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, productSkuId])
  @@index([productSkuId])
  @@map("stock_transfer_items")
  @@schema("inventory")
}

/// A one-off manual correction outside the reservation/transfer/count
/// flows — permission-controlled and audited (`createdBy` always set;
/// `approvedBy` set when the acting role requires a second approver, see
/// docs/security/inventory-security.md).
model InventoryAdjustment {
  id             String                  @id @default(uuid()) @db.Uuid
  warehouseId    String                  @map("warehouse_id") @db.Uuid
  locationId     String                  @map("location_id") @db.Uuid
  productSkuId   String                  @map("product_sku_id") @db.Uuid
  adjustmentType InventoryAdjustmentType @map("adjustment_type")
  quantity       Int
  reason         String
  approvedBy     String?                 @map("approved_by") @db.Uuid
  createdBy      String                  @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation @relation(fields: [locationId], references: [id])

  @@index([warehouseId])
  @@index([productSkuId])
  @@map("inventory_adjustments")
  @@schema("inventory")
}

model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  locationId  String?          @map("location_id") @db.Uuid
  status      StockCountStatus @default(PLANNED)
  countedBy   String?          @map("counted_by") @db.Uuid
  approvedBy  String?          @map("approved_by") @db.Uuid
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])
  items     StockCountItem[]

  @@index([warehouseId])
  @@index([status])
  @@map("stock_counts")
  @@schema("inventory")
}

model StockCountItem {
  id               String   @id @default(uuid()) @db.Uuid
  stockCountId     String   @map("stock_count_id") @db.Uuid
  productSkuId     String   @map("product_sku_id") @db.Uuid
  expectedQuantity Int      @map("expected_quantity")
  countedQuantity  Int?     @map("counted_quantity")
  variance         Int?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, productSkuId])
  @@map("stock_count_items")
  @@schema("inventory")
}

// =============================================================================
// commerce — cart, checkout, orders, payments (blueprint §16-§19, §24-§25)
// =============================================================================

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  ABANDONED
  CONVERTED
  EXPIRED

  @@schema("commerce")
}

/// blueprint §16-§19; Phase 007 — see docs/adr/ADR-007-cart-checkout.md.
/// `guestToken` (was `sessionToken`) is the opaque, 256-bit, unguessable
/// identifier a non-authenticated caller presents via `X-Cart-Token`
/// (ADR-007 decision 10) — never a sequential id, never enumerable.
model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid // nullable — guest checkout; -> customer.customers.id, unenforced
  guestToken String?    @unique @map("guest_token")
  status     CartStatus @default(ACTIVE)
  currency   String     @default("IRR")
  expiresAt  DateTime?  @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  items             CartItem[]
  priceSnapshots    CartPriceSnapshot[]
  coupons           CartCoupon[]
  shippingSelection CartShippingSelection?
  checkoutSessions  CheckoutSession[]

  @@index([customerId])
  @@index([guestToken])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
  @@schema("commerce")
}

/// `configurationSnapshot` carries line-specific choices (lens selection,
/// a prescription *reference* — never raw SPH/CYL/AXIS, customization
/// reference) as a display-oriented JSON summary; `CartItemOption` below is
/// the structured, queryable child of the same data. `configurationHash` is
/// a deterministic hash of `configurationSnapshot` so two adds of the same
/// SKU with the same configuration consolidate into one line (quantity
/// summed) while two adds with *different* configuration stay distinct
/// lines — the brief's "prevent duplicate cart lines where business rules
/// require consolidation" / "preserve line-specific configuration", both at
/// once.
model CartItem {
  id                    String   @id @default(uuid()) @db.Uuid
  cartId                String   @map("cart_id") @db.Uuid
  productSkuId          String   @map("product_sku_id") @db.Uuid
  quantity              Int
  unitPriceSnapshot     BigInt   @map("unit_price_snapshot")
  currency              String   @default("IRR")
  configurationSnapshot Json?    @map("configuration_snapshot")
  configurationHash     String   @default("") @map("configuration_hash")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  cart    Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  options CartItemOption[]

  @@unique([cartId, productSkuId, configurationHash])
  @@index([cartId])
  @@index([productSkuId])
  @@map("cart_items")
  @@schema("commerce")
}

/// Structured child of `CartItem.configurationSnapshot` — one row per
/// selected option (lens type, lens coating, a prescription/customization
/// *reference*). `optionKey` stores an id/reference, never sensitive
/// prescription values themselves (ADR-007 decision 9 / the brief's own
/// rule).
model CartItemOption {
  id              String   @id @default(uuid()) @db.Uuid
  cartItemId      String   @map("cart_item_id") @db.Uuid
  optionType      String   @map("option_type")
  optionKey       String   @map("option_key")
  optionLabel     String?  @map("option_label")
  priceAdjustment BigInt?  @map("price_adjustment")
  createdAt       DateTime @default(now()) @map("created_at")

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_options")
  @@schema("commerce")
}

/// Append-only — one row per `price()` recalculation of a cart, each with
/// its own full per-line `breakdown` (ADR-007 decision 2: "historical
/// checkout calculations must be reproducible" applies just as much to a
/// cart the customer hasn't checked out yet).
model CartPriceSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  currency      String
  subtotal      BigInt
  discountTotal BigInt   @map("discount_total")
  taxTotal      BigInt   @map("tax_total")
  shippingTotal BigInt   @map("shipping_total")
  grandTotal    BigInt   @map("grand_total")
  breakdown     Json
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([calculatedAt])
  @@map("cart_price_snapshots")
  @@schema("commerce")
}

/// One coupon per cart. `couponId` is an unenforced pointer to
/// `marketing.coupons.id` (ADR-007 decision 8) — the resolved discount is
/// snapshotted here at apply-time, re-validated (never blindly re-trusted)
/// on every subsequent `price()`/checkout call.
model CartCoupon {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @unique @map("cart_id") @db.Uuid
  couponId         String   @map("coupon_id") @db.Uuid
  code             String
  resolvedDiscount BigInt   @map("resolved_discount")
  appliedAt        DateTime @default(now()) @map("applied_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_coupons")
  @@schema("commerce")
}

/// A cart's current shipping pick, for a running total before checkout
/// freezes it into `CheckoutSession.shippingSnapshot`.
model CartShippingSelection {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @unique @map("cart_id") @db.Uuid
  shippingMethodId String   @map("shipping_method_id") @db.Uuid
  estimatedCost    BigInt   @map("estimated_cost")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id])

  @@map("cart_shipping_selections")
  @@schema("commerce")
}

enum ShippingMethodType {
  HOME_DELIVERY
  STORE_PICKUP

  @@schema("commerce")
}

/// Database-driven shipping methods (ADR-007 decision 7) — never hardcoded
/// in application code or a frontend. `zoneMatch` is `null` (available
/// nationwide) or a simple `{provinces?: string[], cities?: string[]}`
/// match list — a deliberately flat "zone resolution foundation", not a
/// full zone graph; `warehouseId` (unenforced, -> inventory.warehouses.id)
/// is set for `STORE_PICKUP` methods.
model ShippingMethod {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique
  name            String
  type            ShippingMethodType
  baseCost        BigInt             @map("base_cost")
  freeAboveAmount BigInt?            @map("free_above_amount")
  warehouseId     String?            @map("warehouse_id") @db.Uuid
  zoneMatch       Json?              @map("zone_match")
  isActive        Boolean            @default(true) @map("is_active")
  sortOrder       Int                @default(0) @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  cartSelections CartShippingSelection[]

  @@index([isActive])
  @@map("shipping_methods")
  @@schema("commerce")
}

enum CheckoutStatus {
  OPEN
  VALIDATING
  READY_FOR_PAYMENT
  EXPIRED
  CANCELLED
  CONVERTED

  @@schema("commerce")
}

/// The payment-ready artifact this phase builds toward (ADR-007 decision
/// 1). `idempotencyKey` makes `POST /checkout` safe to retry — same call
/// with the same key always resolves to this same row, never a second
/// session. `pricingSnapshot`/`shippingSnapshot`/`addressSnapshot` freeze
/// what the customer agreed to pay at the moment checkout reached
/// `READY_FOR_PAYMENT`; `CheckoutTotals` (below) is the append-only history
/// of every recalculation leading up to that point.
model CheckoutSession {
  id               String         @id @default(uuid()) @db.Uuid
  cartId           String         @map("cart_id") @db.Uuid
  customerId       String?        @map("customer_id") @db.Uuid // nullable — guest checkout supported through READY_FOR_PAYMENT
  guestToken       String?        @map("guest_token")
  status           CheckoutStatus @default(OPEN)
  currency         String         @default("IRR")
  subtotal         BigInt         @default(0)
  discountTotal    BigInt         @default(0) @map("discount_total")
  taxTotal         BigInt         @default(0) @map("tax_total")
  shippingTotal    BigInt         @default(0) @map("shipping_total")
  grandTotal       BigInt         @default(0) @map("grand_total")
  pricingSnapshot  Json?          @map("pricing_snapshot")
  shippingSnapshot Json?          @map("shipping_snapshot")
  addressSnapshot  Json?          @map("address_snapshot")
  idempotencyKey   String         @unique @map("idempotency_key")
  expiresAt        DateTime?      @map("expires_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  convertedAt      DateTime?      @map("converted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  cart          Cart                       @relation(fields: [cartId], references: [id])
  address       CheckoutAddress?
  totalsHistory CheckoutTotals[]
  validations   CheckoutValidationResult[]
  reservations  CheckoutReservation[]
  order         Order? // Phase 009 — at most one Order per checkout session (Order.checkoutSessionId is @unique)

  @@index([cartId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("checkout_sessions")
  @@schema("commerce")
}

/// Snapshotted at checkout time — from a real `customer.customer_addresses`
/// row (`customerAddressId` set) or freeform guest input
/// (`customerAddressId` null). Never re-read live from the source address
/// afterward (blueprint's own "order ≠ live product" principle, extended
/// to shipping addresses).
model CheckoutAddress {
  id                String   @id @default(uuid()) @db.Uuid
  checkoutSessionId String   @unique @map("checkout_session_id") @db.Uuid
  customerAddressId String?  @map("customer_address_id") @db.Uuid // -> customer.customer_addresses.id, unenforced
  recipientName     String   @map("recipient_name")
  phone             String
  province          String
  city              String
  addressLine1      String   @map("address_line_1")
  addressLine2      String?  @map("address_line_2")
  postalCode        String?  @map("postal_code")
  createdAt         DateTime @default(now()) @map("created_at")

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@map("checkout_addresses")
  @@schema("commerce")
}

/// Append-only — one row per `POST /checkout/:id/price` recalculation
/// (ADR-007 decision 2), each with its own full per-line `breakdown`.
model CheckoutTotals {
  id                String   @id @default(uuid()) @db.Uuid
  checkoutSessionId String   @map("checkout_session_id") @db.Uuid
  currency          String
  subtotal          BigInt
  discountTotal     BigInt   @map("discount_total")
  taxTotal          BigInt   @map("tax_total")
  shippingTotal     BigInt   @map("shipping_total")
  grandTotal        BigInt   @map("grand_total")
  breakdown         Json
  calculatedAt      DateTime @default(now()) @map("calculated_at")

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId])
  @@map("checkout_totals")
  @@schema("commerce")
}

enum CheckoutValidationOutcome {
  PASSED
  FAILED

  @@schema("commerce")
}

/// Append-only — one row per `POST /checkout/:id/validate` call. `issues`
/// is a JSON array of `{code, message, productSkuId?}` — every check listed
/// in the brief's `checkout_validation` list produces a real issue code on
/// failure, not a generic "invalid" string.
model CheckoutValidationResult {
  id                String                    @id @default(uuid()) @db.Uuid
  checkoutSessionId String                    @map("checkout_session_id") @db.Uuid
  outcome           CheckoutValidationOutcome
  issues            Json
  validatedAt       DateTime                  @default(now()) @map("validated_at")

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId])
  @@map("checkout_validations")
  @@schema("commerce")
}

/// Preserves the reservation reference in the checkout session (the
/// brief's own explicit rule) — one row per cart line reserved.
/// `inventoryReservationId` is an unenforced pointer to
/// `inventory.inventory_reservations.id` (ADR-007 decision 4); the
/// reservation itself, and every quantity it holds, lives entirely in
/// Phase 006's ledger — this table only remembers *which* reservation
/// backs *which* checkout line.
model CheckoutReservation {
  id                     String   @id @default(uuid()) @db.Uuid
  checkoutSessionId      String   @map("checkout_session_id") @db.Uuid
  productSkuId           String   @map("product_sku_id") @db.Uuid
  warehouseId            String   @map("warehouse_id") @db.Uuid
  inventoryReservationId String   @map("inventory_reservation_id") @db.Uuid
  quantity               Int
  createdAt              DateTime @default(now()) @map("created_at")

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@unique([checkoutSessionId, productSkuId])
  @@index([checkoutSessionId])
  @@index([inventoryReservationId])
  @@map("checkout_reservations")
  @@schema("commerce")
}

// =============================================================================
// order — Phase 009 (see docs/adr/ADR-009-order-fulfillment.md). Replaces
// the Phase 003 placeholder Order/OrderItem/OrderStatusHistory (confirmed
// 0 rows, unreferenced by any application code before this migration) and
// the finance-schema placeholder Invoice/InvoiceLine below. Anchored on
// CheckoutSession + PaymentIntent (both real, enforced, same-schema FKs,
// both @unique — the idempotency guarantee ADR-009 decision 4 relies on),
// never on nothing. Fulfillment/Shipment live in this same `commerce`
// schema rather than a new schema of their own — they are an extension of
// "what happens to an order," not a distinct business domain.
// =============================================================================

enum OrderSource {
  STOREFRONT
  ADMIN
  POS

  @@schema("commerce")
}

/// The 8-state lifecycle ADR-009 decision 5 defines. CANCELLED/COMPLETED
/// are strictly terminal; CANCELLED is unreachable once PARTIALLY_FULFILLED
/// or later. Enforced only by `OrderStateMachine` (domain layer) — no
/// column-level CHECK constraint (Prisma has none).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_FULFILL
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  COMPLETED

  @@schema("commerce")
}

/// Cached read alongside `status` (ADR-009 decision 3) — never the source
/// of truth; always derived from Payment's own `PaymentTransaction`/
/// `Refund` rows the moment `OrderService` learns of them.
enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@schema("commerce")
}

/// Cached read alongside `status` (ADR-009 decision 3) — always derived
/// from this order's own `FulfillmentItem` sums, never independently
/// tracked.
enum OrderFulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED

  @@schema("commerce")
}

/// blueprint §17/§25 — Order ≠ live Product: every price/name/sku field an
/// order needs is snapshotted at creation (on OrderItem), never re-read from
/// the live catalog. Status transitions are recorded in OrderStatusHistory,
/// never silently overwritten. `checkoutSessionId`/`paymentIntentId` are
/// both real, enforced, `@unique` FKs into this same schema — the
/// idempotency anchor for `OrderConversionService` (ADR-009 decision 4):
/// a duplicate/concurrent conversion attempt collapses to this same row via
/// a `P2002` catch-and-reread, never a second `Order`.
model Order {
  id                      String                 @id @default(uuid()) @db.Uuid
  orderNumber             String                 @unique @map("order_number")
  checkoutSessionId       String                 @unique @map("checkout_session_id") @db.Uuid
  paymentIntentId         String                 @unique @map("payment_intent_id") @db.Uuid
  customerId              String?                @map("customer_id") @db.Uuid // nullable — guest order; -> customer.customers.id, unenforced
  guestToken              String?                @map("guest_token")
  source                  OrderSource            @default(STOREFRONT)
  status                  OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus           OrderPaymentStatus     @default(UNPAID) @map("payment_status")
  fulfillmentStatus       OrderFulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  currency                String                 @default("IRR")
  subtotal                BigInt
  discountTotal           BigInt                 @default(0) @map("discount_total")
  taxTotal                BigInt                 @default(0) @map("tax_total")
  shippingTotal           BigInt                 @default(0) @map("shipping_total")
  grandTotal              BigInt                 @map("grand_total")
  paidTotal               BigInt                 @default(0) @map("paid_total")
  refundedTotal           BigInt                 @default(0) @map("refunded_total")
  shippingAddressSnapshot Json                   @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?                  @map("billing_address_snapshot")
  placedAt                DateTime               @default(now()) @map("placed_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  cancelledAt             DateTime?              @map("cancelled_at")
  completedAt             DateTime?              @map("completed_at")

  checkoutSession CheckoutSession      @relation(fields: [checkoutSessionId], references: [id])
  paymentIntent   PaymentIntent        @relation(fields: [paymentIntentId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  fulfillments    Fulfillment[]

  @@index([customerId])
  @@index([guestToken])
  @@index([status])
  @@map("orders")
  @@schema("commerce")
}

/// `productSkuId` (Phase 005 — was `productVariantId`; see ADR-005 decision 1),
/// nullable since the live SKU may later be deleted — `skuSnapshot`/
/// `nameSnapshot`/`unitPriceSnapshot` carry the historical truth regardless
/// (ADR-009 decision 1). `discountAmount`/`taxAmount` copied from the
/// checkout's own `CheckoutTotals.breakdown` line, never recomputed here.
model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productSkuId      String?  @map("product_sku_id") @db.Uuid
  skuSnapshot       String   @map("sku_snapshot")
  nameSnapshot      String   @map("name_snapshot")
  unitPriceSnapshot BigInt   @map("unit_price_snapshot")
  quantity          Int
  discountAmount    BigInt   @default(0) @map("discount_amount")
  taxAmount         BigInt   @default(0) @map("tax_amount")
  lineTotal         BigInt   @map("line_total")
  createdAt         DateTime @default(now()) @map("created_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
  @@map("order_items")
  @@schema("commerce")
}

/// Append-only — `changedBy = null` represents a system-generated
/// transition (e.g. the `order_conversion`/`order_expiration` sweeps),
/// same convention `system.AuditLog.actorId` already uses; never a
/// fabricated actor row.
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by") @db.Uuid // nullable — null means system-generated; -> identity.users.id, unenforced
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
  @@schema("commerce")
}

/// The 8-state fulfillment lifecycle (ADR-009 decision 8). An `Order` may
/// have many `Fulfillment` rows (partial fulfillment). `warehouseId` is an
/// unenforced cross-schema pointer, same convention every other
/// commerce->inventory reference in this schema already uses.
enum FulfillmentStatus {
  PENDING
  ALLOCATED
  PROCESSING
  PACKED
  READY
  SHIPPED
  DELIVERED
  CANCELLED

  @@schema("commerce")
}

model Fulfillment {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  status      FulfillmentStatus @default(PENDING)
  warehouseId String?           @map("warehouse_id") @db.Uuid // -> inventory.warehouses.id, unenforced
  packedAt    DateTime?         @map("packed_at")
  shippedAt   DateTime?         @map("shipped_at")
  deliveredAt DateTime?         @map("delivered_at")
  cancelledAt DateTime?         @map("cancelled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items    FulfillmentItem[]
  shipment Shipment?

  @@index([orderId])
  @@index([status])
  @@map("fulfillments")
  @@schema("commerce")
}

/// References a concrete `OrderItem`, never a bare SKU string (ADR-009
/// decision 8) — `quantity` here plus every sibling `FulfillmentItem`
/// across every non-CANCELLED `Fulfillment` for the same `orderItemId` can
/// never exceed `OrderItem.quantity`; enforced in the domain layer via a
/// row-locked re-sum at write time (`mutateInventoryItem`'s own
/// `SELECT ... FOR UPDATE` technique, reused), not a database constraint.
model FulfillmentItem {
  id            String   @id @default(uuid()) @db.Uuid
  fulfillmentId String   @map("fulfillment_id") @db.Uuid
  orderItemId   String   @map("order_item_id") @db.Uuid
  quantity      Int
  createdAt     DateTime @default(now()) @map("created_at")

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id])

  @@index([fulfillmentId])
  @@index([orderItemId])
  @@map("fulfillment_items")
  @@schema("commerce")
}

/// ADR-009 decision 12 — one `Shipment` per `Fulfillment` (1:0..1). No live
/// courier integration; `carrier`/`trackingNumber` are admin-entered via
/// `ManualShippingProvider`.
enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED

  @@schema("commerce")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  fulfillmentId  String         @unique @map("fulfillment_id") @db.Uuid
  carrier        String?
  trackingNumber String?        @map("tracking_number")
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  fulfillment Fulfillment     @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  events      ShipmentEvent[]

  @@map("shipments")
  @@schema("commerce")
}

/// Append-only tracking history. `source` is a plain string (not an enum)
/// since no live courier webhook exists yet to give it a real closed
/// vocabulary — always `"MANUAL_ADMIN"` or `"SYSTEM"` in this phase,
/// deliberately not over-modeled ahead of a real integration.
model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  status     ShipmentStatus
  location   String?
  details    Json?
  source     String         @default("MANUAL_ADMIN")
  occurredAt DateTime       @default(now()) @map("occurred_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
  @@schema("commerce")
}

// =============================================================================
// payment — provider-independent orchestration (Phase 008 — see
// docs/adr/ADR-008-payment-orchestration.md). Replaces the Phase 003
// placeholder Payment/Refund (orderId-keyed — unusable, no Order exists
// yet). PaymentIntent -> PaymentAttempt -> PaymentTransaction, three
// levels, not one (ADR-008 decision 2).
// =============================================================================

enum PaymentIntentStatus {
  CREATED
  AWAITING_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("commerce")
}

enum PaymentAttemptStatus {
  INITIATED
  REDIRECTED
  RETURNED
  ABANDONED
  EXPIRED

  @@schema("commerce")
}

enum PaymentTransactionStatus {
  PENDING
  VERIFIED
  FAILED

  @@schema("commerce")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED

  @@schema("commerce")
}

enum ReconciliationStatus {
  MATCHED
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  MISSING_LOCAL
  MISSING_REMOTE

  @@schema("commerce")
}

/// A configured payment gateway (ADR-008 decision 5). `config` holds only
/// non-secret operational settings — the real merchant id/API key each
/// adapter needs comes from environment variables, namespaced per `code`
/// (ADR-008 decision 8), never persisted here.
model PaymentProvider {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique // e.g. "zarinpal" — PAYMENT_PROVIDER_ADAPTER resolves on this
  name              String
  isActive          Boolean   @default(true) @map("is_active")
  isSandbox         Boolean   @default(true) @map("is_sandbox")
  config            Json? // non-secret settings only (callback URL template, timeout, ...)
  lastHealthCheckAt DateTime? @map("last_health_check_at")
  lastHealthCheckOk Boolean?  @map("last_health_check_ok")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  intents PaymentIntent[]

  @@map("payment_providers")
  @@schema("commerce")
}

/// One per `CheckoutSession` (`@unique` — ADR-008 decisions 1/9); the
/// durable "customer owes `grandTotal`" fact. `amount`/`currency` are
/// fixed at creation from the checkout session's own totals, never
/// re-read live and never accepted from the client. `checkoutSessionId`
/// is an unenforced pointer to `commerce.checkout_sessions.id` — both
/// tables live in the same `commerce` schema, but this module never
/// imports cart-checkout's domain layer directly (real service
/// injection instead, ADR-008 decision 10), so the FK stays a plain
/// column, same convention every other same-schema-but-different-module
/// pointer in this repo follows once the modules themselves don't share
/// a Prisma relation.
model PaymentIntent {
  id                String              @id @default(uuid()) @db.Uuid
  checkoutSessionId String              @unique @map("checkout_session_id") @db.Uuid
  customerId        String?             @map("customer_id") @db.Uuid // nullable — guest checkout; -> customer.customers.id, unenforced
  guestToken        String?             @map("guest_token")
  providerId        String              @map("provider_id") @db.Uuid
  status            PaymentIntentStatus @default(CREATED)
  amount            BigInt
  currency          String              @default("IRR")
  idempotencyKey    String              @unique @map("idempotency_key")
  expiresAt         DateTime?           @map("expires_at")
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  provider     PaymentProvider      @relation(fields: [providerId], references: [id])
  attempts     PaymentAttempt[]
  transactions PaymentTransaction[]
  callbacks    PaymentCallback[]
  order        Order? // Phase 009 — at most one Order per intent (Order.paymentIntentId is @unique)

  @@index([customerId])
  @@index([status])
  @@map("payment_intents")
  @@schema("commerce")
}

/// One per redirect round trip (ADR-008 decision 2) — a retried checkout
/// creates a new attempt, never mutates a prior one.
model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  paymentIntentId   String               @map("payment_intent_id") @db.Uuid
  attemptNumber     Int                  @map("attempt_number")
  providerAuthority String?              @map("provider_authority") // the gateway's own reference for this attempt (e.g. ZarinPal Authority)
  redirectUrl       String?              @map("redirect_url")
  status            PaymentAttemptStatus @default(INITIATED)
  startedAt         DateTime             @default(now()) @map("started_at")
  returnedAt        DateTime?            @map("returned_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  paymentIntent PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  transactions  PaymentTransaction[]

  @@unique([paymentIntentId, attemptNumber])
  @@index([paymentIntentId])
  @@index([providerAuthority])
  @@map("payment_attempts")
  @@schema("commerce")
}

/// The verified, immutable settlement record (ADR-008 decisions 2-3) —
/// created only from a real server-to-server `verifyPayment()` call.
/// Never updated once `VERIFIED` — no repository method exposes an
/// update path for a `VERIFIED` row's `amount`/`status`.
model PaymentTransaction {
  id                      String                   @id @default(uuid()) @db.Uuid
  paymentIntentId         String                   @map("payment_intent_id") @db.Uuid
  paymentAttemptId        String?                  @map("payment_attempt_id") @db.Uuid
  providerId              String                   @map("provider_id") @db.Uuid
  providerReference       String                   @map("provider_reference") // e.g. ZarinPal RefID
  amount                  BigInt
  currency                String                   @default("IRR")
  status                  PaymentTransactionStatus @default(PENDING)
  verifiedAt              DateTime?                @map("verified_at")
  rawVerificationResponse Json?                    @map("raw_verification_response")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  paymentIntent   PaymentIntent          @relation(fields: [paymentIntentId], references: [id])
  paymentAttempt  PaymentAttempt?        @relation(fields: [paymentAttemptId], references: [id])
  refunds         Refund[]
  reconciliations ReconciliationRecord[]

  @@unique([providerId, providerReference])
  @@index([paymentIntentId])
  @@index([status])
  @@map("payment_transactions")
  @@schema("commerce")
}

/// Raw, append-only inbox for every inbound callback/webhook (ADR-008
/// decision 4) — persisted verbatim before any processing, so a rejected
/// callback still leaves an audit trail. `dedupeKey` makes a provider's
/// at-least-once redelivery idempotent by construction.
model PaymentCallback {
  id              String    @id @default(uuid()) @db.Uuid
  paymentIntentId String?   @map("payment_intent_id") @db.Uuid // nullable — may be unresolvable if malformed
  providerId      String    @map("provider_id") @db.Uuid
  dedupeKey       String    @unique @map("dedupe_key")
  rawPayload      Json      @map("raw_payload")
  signatureValid  Boolean   @map("signature_valid")
  processedAt     DateTime? @map("processed_at")
  receivedAt      DateTime  @default(now()) @map("received_at")

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([paymentIntentId])
  @@index([providerId])
  @@map("payment_callbacks")
  @@schema("commerce")
}

/// Against an immutable `VERIFIED` transaction — validated to never
/// exceed the transaction's own amount across every prior non-rejected
/// refund (ADR-008 decision 6).
model Refund {
  id                      String       @id @default(uuid()) @db.Uuid
  paymentTransactionId    String       @map("payment_transaction_id") @db.Uuid
  amount                  BigInt
  reason                  String?
  status                  RefundStatus @default(PENDING)
  requestedBy             String?      @map("requested_by") @db.Uuid // -> identity.users.id, unenforced
  providerRefundReference String?      @map("provider_refund_reference")
  idempotencyKey          String       @unique @map("idempotency_key")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@index([paymentTransactionId])
  @@index([status])
  @@map("refunds")
  @@schema("commerce")
}

/// Compares local `PaymentTransaction` rows against the provider's own
/// settlement report — records a finding, never silently corrects
/// (ADR-008 decision 7).
model ReconciliationRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  providerId           String               @map("provider_id") @db.Uuid
  transactionDate      DateTime             @map("transaction_date") @db.Date
  paymentTransactionId String?              @map("payment_transaction_id") @db.Uuid // nullable — null for a MISSING_LOCAL finding
  providerReference    String               @map("provider_reference")
  localAmount          BigInt?              @map("local_amount")
  remoteAmount         BigInt?              @map("remote_amount")
  status               ReconciliationStatus
  resolvedAt           DateTime?            @map("resolved_at")
  resolutionNote       String?              @map("resolution_note")
  createdAt            DateTime             @default(now()) @map("created_at")

  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([providerId])
  @@index([status])
  @@index([transactionDate])
  @@map("reconciliation_records")
  @@schema("commerce")
}

// =============================================================================
// marketing — coupons, promotions, campaigns (blueprint §33-§37, §69)
// =============================================================================

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT

  @@schema("marketing")
}

enum CampaignChannel {
  SMS
  EMAIL
  PUSH
  IN_APP

  @@schema("marketing")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED

  @@schema("marketing")
}

model Coupon {
  id                String     @id @default(uuid()) @db.Uuid
  code              String     @unique
  type              CouponType
  value             BigInt // percentage (0-10000 basis points) or a Rial amount, per `type`
  minOrderAmount    BigInt?    @map("min_order_amount")
  maxDiscountAmount BigInt?    @map("max_discount_amount")
  usageLimit        Int?       @map("usage_limit")
  perUserLimit      Int?       @map("per_user_limit")
  startsAt          DateTime?  @map("starts_at")
  endsAt            DateTime?  @map("ends_at")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  redemptions CouponRedemption[]

  @@map("coupons")
  @@schema("marketing")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  discountAmount BigInt   @map("discount_amount")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
  @@map("coupon_redemptions")
  @@schema("marketing")
}

/// blueprint §14 — a basic, ruleless promotion (all-or-nothing % or fixed
/// off, scoped to specific products). The full condition/rule engine
/// (customer segment + category + cart-total conditions) is future work.
model Promotion {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  discountType  CouponType @map("discount_type")
  discountValue BigInt     @map("discount_value")
  startsAt      DateTime   @map("starts_at")
  endsAt        DateTime   @map("ends_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  products PromotionProduct[]

  @@map("promotions")
  @@schema("marketing")
}

model PromotionProduct {
  promotionId String   @map("promotion_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
  @@schema("marketing")
}

model Campaign {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  key         String          @unique
  channel     CampaignChannel
  status      CampaignStatus  @default(DRAFT)
  scheduledAt DateTime?       @map("scheduled_at")
  startedAt   DateTime?       @map("started_at")
  endedAt     DateTime?       @map("ended_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("campaigns")
  @@schema("marketing")
}

// =============================================================================
// cms — pages, content, navigation (blueprint §45-§49)
// =============================================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("cms")
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  sections PageSection[]

  @@map("pages")
  @@schema("cms")
}

/// blueprint §46 — `type` + `config` (JSON) is the Section Builder: new
/// section types are data, not a schema migration or a frontend redeploy.
model PageSection {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  type      String // "Hero" | "ProductCarousel" | "Banner" | ...
  sortOrder Int      @default(0) @map("sort_order")
  config    Json
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_sections")
  @@schema("cms")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  placement String // "HOME_HERO" | "CATEGORY_TOP" | ... — free-form, admin-managed
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
  @@schema("cms")
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  title         String
  excerpt       String?
  contentHtml   String        @map("content_html")
  coverImageUrl String?       @map("cover_image_url")
  authorId      String?       @map("author_id") @db.Uuid
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  @@map("articles")
  @@schema("cms")
}

model Menu {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // "header" | "footer" | ...
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@map("menus")
  @@schema("cms")
}

model MenuItem {
  id        String   @id @default(uuid()) @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  label     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemToParent", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemToParent")

  @@index([menuId])
  @@map("menu_items")
  @@schema("cms")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
  @@schema("cms")
}

// =============================================================================
// finance — pricing (kept independent of catalog per blueprint §12), price
// history, invoices (blueprint §12-§13, §39)
// =============================================================================

/// blueprint §12 — Pricing is its own domain, not a bare column on Product.
/// Exactly one active price row per SKU; changes go through PriceHistory,
/// never a silent overwrite. `productSkuId` (Phase 005 — was
/// `productVariantId`; see ADR-005 decision 1) stays a plain, unenforced
/// cross-schema column into `catalog.product_skus`. `compareAtPrice` +
/// `validFrom`/`validTo` are Phase 005's scheduled-pricing foundation —
/// `validFrom`/`validTo` describe *this row's* effective window; a future
/// scheduled price change is a new row that isn't active yet, resolved by
/// the application layer picking the row whose window contains "now", not a
/// cron job mutating `basePrice` in place.
model ProductPrice {
  id             String    @id @default(uuid()) @db.Uuid
  productSkuId   String    @unique @map("product_sku_id") @db.Uuid
  basePrice      BigInt    @map("base_price")
  compareAtPrice BigInt?   @map("compare_at_price")
  costPrice      BigInt?   @map("cost_price")
  currency       String    @default("IRR")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("product_prices")
  @@schema("finance")
}

/// blueprint §13 — append-only, mirrors the exact example in the blueprint
/// (SKU, old price, new price, changed by, reason). `productSkuId` (Phase
/// 005 — was `productVariantId`).
model PriceHistory {
  id           String   @id @default(uuid()) @db.Uuid
  productSkuId String   @map("product_sku_id") @db.Uuid
  oldPrice     BigInt?  @map("old_price")
  newPrice     BigInt   @map("new_price")
  changedBy    String?  @map("changed_by") @db.Uuid
  reason       String?
  changedAt    DateTime @default(now()) @map("changed_at")

  @@index([productSkuId])
  @@map("price_history")
  @@schema("finance")
}

/// ADR-009 decision 7. `orderId` is `@unique` (one invoice per order, this
/// phase never issues more than one) and, same convention as every other
/// cross-schema pointer in this repo, unenforced (`finance` -> `commerce`).
/// `invoiceNumber` is server-generated from `finance.invoice_number_seq`
/// (never client input) at issuance. Immutable once ISSUED — no repository
/// method exposes an update path for `subtotal`/`taxTotal`/`grandTotal`/
/// `items`; a correction is `VOID` plus manual admin follow-up.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  CANCELLED

  @@schema("finance")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  orderId       String        @unique @map("order_id") @db.Uuid // -> commerce.orders.id, unenforced
  customerId    String?       @map("customer_id") @db.Uuid // -> customer.customers.id, unenforced
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("IRR")
  subtotal      BigInt
  discountTotal BigInt        @default(0) @map("discount_total")
  taxTotal      BigInt        @default(0) @map("tax_total")
  shippingTotal BigInt        @default(0) @map("shipping_total")
  grandTotal    BigInt        @map("grand_total")
  issuedAt      DateTime?     @map("issued_at")
  voidedAt      DateTime?     @map("voided_at")
  pdfUrl        String?       @map("pdf_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items InvoiceItem[]

  @@index([orderId])
  @@map("invoices")
  @@schema("finance")
}

model InvoiceItem {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  lineTotal   BigInt @map("line_total")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
  @@schema("finance")
}

// =============================================================================
// notification — templates, delivery log, per-customer channel consent
// (blueprint §38-§44, §75)
// =============================================================================

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED

  @@schema("notification")
}

/// blueprint §44 — `body` holds `{{variable}}` placeholders; admin-editable,
/// no code deploy needed to change copy.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @unique // "ORDER_CREATED", "OTP", ...
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  logs NotificationLog[]

  @@map("notification_templates")
  @@schema("notification")
}

model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  templateId   String?             @map("template_id") @db.Uuid
  channel      NotificationChannel
  recipient    String
  customerId   String?             @map("customer_id") @db.Uuid
  status       NotificationStatus  @default(QUEUED)
  providerRef  String?             @map("provider_ref")
  errorMessage String?             @map("error_message")
  sentAt       DateTime?           @map("sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("notification_logs")
  @@schema("notification")
}

/// blueprint §75 — explicit per-channel consent, checked before every send.
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @unique @map("customer_id") @db.Uuid
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  whatsappEnabled Boolean  @default(true) @map("whatsapp_enabled")
  telegramEnabled Boolean  @default(true) @map("telegram_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
  @@schema("notification")
}

// =============================================================================
// analytics — event capture (blueprint §67-§68)
// =============================================================================

/// One generic, append-only event table rather than a bespoke table per
/// event type — `eventType` + `metadata` (JSON) covers product views,
/// searches, filters, cart actions, etc. Promote a specific event type to
/// its own structured table only once it needs real relational querying.
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") // "PRODUCT_VIEW" | "SEARCH" | "ADD_TO_CART" | ...
  customerId String?  @map("customer_id") @db.Uuid
  sessionId  String?  @map("session_id")
  productId  String?  @map("product_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType, occurredAt])
  @@index([customerId])
  @@map("analytics_events")
  @@schema("analytics")
}

// =============================================================================
// system — audit log, API keys, webhooks, feature flags, settings
// (blueprint §54-§55, §86-§87)
// =============================================================================

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("system")
}

/// blueprint §54 — the append-only "who changed what" record. Every
/// sensitive mutation (price change, role change, refund approval, ...)
/// should write one of these; nothing here is ever updated after insert.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorIp     String?  @map("actor_ip")
  actorDevice String?  @map("actor_device") // -> identity.user_devices.id, unenforced (see docs/database/README.md#cross-schema-references-are-intentionally-unenforced) — blueprint §54 lists "Device" alongside "IP" on every audit entry
  action      String // "PRODUCT_PRICE_CHANGED", "ROLE_ASSIGNED", ...
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
  @@schema("system")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  ownerId    String?   @map("owner_id") @db.Uuid
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("api_keys")
  @@schema("system")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@map("webhooks")
  @@schema("system")
}

model WebhookDelivery {
  id          String                @id @default(uuid()) @db.Uuid
  webhookId   String                @map("webhook_id") @db.Uuid
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempt     Int                   @default(1)
  respondedAt DateTime?             @map("responded_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
  @@schema("system")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("system")
}

/// blueprint §87 — generic key-value store for business settings (company
/// info, order/payment/shipping/SEO config, ...). `value` is JSON so the
/// shape is whatever that setting needs, not a fixed column set.
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("system")
}
