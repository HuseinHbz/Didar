// IECP database schema — Phase 1 foundation.
//
// Scope: this is the enterprise database FOUNDATION (per Phase 003's own
// title), covering the primary entities across all 11 domain schemas — not
// full coverage of every table docs/product/blueprint.md eventually wants.
// Deliberately deferred for a later pass: procurement/supplier management,
// retail/POS/appointments, full rule-engine promotions, the complete lens
// pricing engine. See docs/database/README.md for exactly what's in vs. out
// and why.
//
// Conventions (see docs/database/README.md for the full rationale):
//   - UUID primary keys everywhere (blueprint §58).
//   - Money is always BigInt (Rial, integer, blueprint §90) — never Float.
//   - "Lifecycle" entities (created, edited, eventually soft-deleted by a
//     human) get the full createdAt/updatedAt/deletedAt trio.
//   - Append-only records (a fact captured once, never edited) get
//     createdAt only — a fabricated updatedAt/deletedAt on an immutable log
//     row would be actively misleading, not extra compliance.
//   - Pure join tables get a composite PK and createdAt only.
//   - snake_case in Postgres (@@map/@map), camelCase/PascalCase in Prisma.
//   - One PostgreSQL schema per business domain (multiSchema, GA since
//     Prisma 6 — see the file-level note on the `schemas` line below).

generator client {
  provider = "prisma-client-js"
}

// NOTE: `schemas` must be a single-line array — Prisma 6.19.3's parser
// rejects a multi-line one here (confirmed the hard way in Phase 001; see
// git history). Order matches docs/database/README.md, not creation order.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "customer", "catalog", "commerce", "inventory", "marketing", "cms", "finance", "notification", "analytics", "system"]
}

// =============================================================================
// Shared enums (declared once, used across schemas; each still needs its own
// @@schema since Postgres enum types are schema-scoped)
// =============================================================================

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  PROCESSING
  PRESCRIPTION_REVIEW
  LENS_PRODUCTION
  QUALITY_CONTROL
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUND_PENDING
  REFUNDED

  @@schema("commerce")
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGE
  ADJUSTMENT
  RETURN
  COUNT_ADJUSTMENT

  @@schema("inventory")
}

enum NotificationChannel {
  SMS
  TELEGRAM
  WHATSAPP
  EMAIL
  PUSH
  IN_APP

  @@schema("notification")
}

// =============================================================================
// identity — users, credentials/sessions, OTP, RBAC (blueprint §5)
// =============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String    @unique
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions            UserSession[]
  roles               UserRole[]
  devices             UserDevice[]
  twoFactorCredential TwoFactorCredential?
  permissionOverrides UserPermissionOverride[]
  securityEvents      SecurityEvent[]

  @@map("users")
  @@schema("identity")
}

/// One row per browser/app install a user has logged in from (blueprint
/// §5/§56 `user_devices`, "Device Trust" for admin). Distinct from
/// UserSession: a device can accumulate many sessions over time (re-login
/// after a refresh token expires reuses the same device row via
/// `fingerprint`), and `trustedAt` persists across those logins.
model UserDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fingerprint String // hash of a client-supplied device signature (UA + platform + app-generated install id) — never the raw signature
  label       String? // e.g. "Ali's iPhone" — user-editable, not derived
  platform    String? // "ios" | "android" | "web" | ...
  trustedAt   DateTime? @map("trusted_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("user_devices")
  @@schema("identity")
}

/// Session/refresh-token tracking (blueprint §55/§56) — one row per issued
/// refresh token. `deviceId` links a session to the device it was issued
/// from; nullable because not every historical/edge-case login path is
/// guaranteed to resolve a device (e.g. a future server-to-server flow).
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@map("user_sessions")
  @@schema("identity")
}

enum TwoFactorMethod {
  TOTP

  @@schema("identity")
}

/// blueprint §55/§56 `user_two_factor` — one credential per user (only TOTP
/// implemented; modeled as an enum, not a bare boolean, so a second method
/// is an additive migration later, not a schema redesign). `secretEncrypted`
/// is AES-256-GCM ciphertext (see EncryptionService) — the raw TOTP secret
/// is never stored at rest. `recoveryCodesHashed` mirrors `password_hash`'s
/// convention: hashed, one-time-use, never stored or logged in the clear.
model TwoFactorCredential {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  method              TwoFactorMethod @default(TOTP)
  secretEncrypted     String          @map("secret_encrypted")
  recoveryCodesHashed String[]        @map("recovery_codes_hashed")
  enabled             Boolean         @default(false)
  verifiedAt          DateTime?       @map("verified_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor_credentials")
  @@schema("identity")
}

/// Mobile OTP (blueprint §56: primary auth mechanism). Append-only — a
/// consumed/expired code is never edited, only superseded by a new request.
model OtpRequest {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String // LOGIN | REGISTER | RESET_PASSWORD — kept as a string, not an enum, since new purposes are cheap to add and don't need a migration
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_requests")
  @@schema("identity")
}

/// blueprint §53 — roles form a tree via `parentId` (e.g. the blueprint's own
/// Admin → Commerce → Products example). A role's *effective* permissions are
/// its own `RolePermission` rows unioned with every ancestor's, resolved
/// recursively by PermissionResolver (services/api identity module) — the
/// database only stores the edges, not the resolved closure.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Role?            @relation("RoleToParent", fields: [parentId], references: [id])
  children    Role[]           @relation("RoleToParent")
  permissions RolePermission[]
  users       UserRole[]

  @@index([parentId])
  @@map("roles")
  @@schema("identity")
}

/// blueprint §53's fine-grained permission model. `key` (e.g.
/// "identity.users.view_contact") is the canonical identifier used
/// everywhere in code; `module`/`action` are the same string split into
/// queryable columns so an admin UI can render a module × action matrix
/// without parsing `key`. `module` is a free-form string, not an enum tied
/// to the 11 Postgres domain schemas — permissions are registered per
/// NestJS module as that module is built (see services/api's identity
/// module for what's registered so far), not pre-declared for domains that
/// don't have endpoints yet.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String
  action      String
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@unique([module, action])
  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

enum PermissionEffect {
  ALLOW
  DENY

  @@schema("identity")
}

/// blueprint §53's per-user exception example ("Product.Publish = NO" even
/// though the user's role would otherwise grant it). Resolved on top of the
/// role-derived permission set; DENY always wins over any role grant, ALLOW
/// grants something no assigned role does. Not a join table (no composite
/// PK) because `effect`/`reason`/`createdBy` are real per-row data, not just
/// an association.
model UserPermissionOverride {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect
  reason       String?
  createdBy    String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
  @@schema("identity")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_FAILED
  SESSION_REVOKED
  SESSION_REFRESHED
  API_KEY_CREATED
  API_KEY_REVOKED

  @@schema("identity")
}

/// blueprint §5/§55 `user_security_events` — the "Login Attempts / Failed
/// Login / Security Events" leg of the Security Center list. Append-only,
/// written alongside (not instead of) `system.AuditLog`: AuditLog is the
/// general-purpose "who changed what" record for any mutation across any
/// domain, this is identity-specific and always has a `type` from a fixed,
/// known set, which makes it cheap to query/alert on without parsing
/// `AuditLog.action` strings. `userId` is nullable — a failed login attempt
/// against a phone/email with no matching account still needs a row.
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  type      SecurityEventType
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
  @@schema("identity")
}

// =============================================================================
// customer — the person, their addresses/family, and their loyalty/wallet
// accounts (blueprint §6/§15/§32/§35, USPs #5-#6)
// =============================================================================

enum CustomerGender {
  MALE
  FEMALE
  OTHER

  @@schema("customer")
}

enum FamilyRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  OTHER

  @@schema("customer")
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  VIP

  @@schema("customer")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST

  @@schema("customer")
}

enum WalletTransactionType {
  CASHBACK
  REFUND
  GIFT
  CREDIT
  DEBIT
  EXPIRATION

  @@schema("customer")
}

model Customer {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @unique @map("user_id") @db.Uuid
  firstName  String          @map("first_name")
  lastName   String          @map("last_name")
  nationalId String?         @unique @map("national_id")
  birthDate  DateTime?       @map("birth_date") @db.Date
  gender     CustomerGender?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  addresses      CustomerAddress[]
  familyMembers  FamilyMember[]
  segments       CustomerSegmentMember[]
  loyaltyAccount LoyaltyAccount?
  walletAccount  WalletAccount?

  @@map("customers")
  @@schema("customer")
}

model CustomerAddress {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  label         String? // "خانه", "محل کار", ...
  recipientName String    @map("recipient_name")
  phone         String
  province      String
  city          String
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  postalCode    String?   @map("postal_code")
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
  @@schema("customer")
}

/// blueprint §15 — a family member is a lightweight profile, not necessarily
/// its own User/Customer account (a child may never log in themselves).
model FamilyMember {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  relation   FamilyRelation
  firstName  String         @map("first_name")
  lastName   String         @map("last_name")
  birthDate  DateTime?      @map("birth_date") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("family_members")
  @@schema("customer")
}

/// blueprint §70 — segments are admin-defined (e.g. "VIP", "Cart Abandoner");
/// membership is computed/assigned, not a fixed enum.
model CustomerSegment {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members CustomerSegmentMember[]

  @@map("customer_segments")
  @@schema("customer")
}

model CustomerSegmentMember {
  customerId String   @map("customer_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at")

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([customerId, segmentId])
  @@map("customer_segment_members")
  @@schema("customer")
}

/// blueprint §32 — points are a ledger (LoyaltyTransaction), not a single
/// mutable counter; pointsBalance here is a maintained cache of the sum.
model LoyaltyAccount {
  id            String      @id @default(uuid()) @db.Uuid
  customerId    String      @unique @map("customer_id") @db.Uuid
  pointsBalance Int         @default(0) @map("points_balance")
  tier          LoyaltyTier @default(BRONZE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
  @@schema("customer")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid()) @db.Uuid
  loyaltyAccountId String                 @map("loyalty_account_id") @db.Uuid
  type             LoyaltyTransactionType
  points           Int
  reason           String?
  createdAt        DateTime               @default(now()) @map("created_at")

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId])
  @@map("loyalty_transactions")
  @@schema("customer")
}

/// blueprint §35/§116 — same ledger discipline as loyalty, in Rial.
model WalletAccount {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  balance    BigInt   @default(0)
  currency   String   @default("IRR")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet_accounts")
  @@schema("customer")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletAccountId String                @map("wallet_account_id") @db.Uuid
  type            WalletTransactionType
  amount          BigInt
  balanceAfter    BigInt                @map("balance_after")
  reference       String?
  createdAt       DateTime              @default(now()) @map("created_at")

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  @@index([walletAccountId])
  @@map("wallet_transactions")
  @@schema("customer")
}

// =============================================================================
// catalog — brands, categories, collections, products, variants, SKUs,
// attributes/filters, media (blueprint §7-§13). Phase 005 — see
// docs/adr/ADR-005-catalog-architecture.md for why variant and SKU are two
// different models (decision 1), why SEO/AR fields are typed JSON columns
// (decision 3), and why dynamic collections store a narrow rule bag instead
// of a general rule engine (decision 4).
// =============================================================================

enum ProductGender {
  MALE
  FEMALE
  UNISEX
  KIDS

  @@schema("catalog")
}

/// blueprint §7 / Phase 005 `business_context.product_domain`.
enum ProductType {
  EYEGLASSES
  SUNGLASSES
  COMPUTER_GLASSES
  READING_GLASSES
  CONTACT_LENSES
  OPTICAL_FRAME
  LENS
  ACCESSORY

  @@schema("catalog")
}

/// Product publication state machine (Phase 005 `product_lifecycle`),
/// enforced by ProductLifecycleStateMachine (domain layer) before it ever
/// reaches the database — see services/api/src/modules/catalog/README.md.
enum ProductLifecycleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@schema("catalog")
}

/// Simple on/off switch for merchandising entities that don't need the full
/// product publication workflow (brand, category, collection, variant).
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@schema("catalog")
}

/// DISCONTINUED is distinct from INACTIVE: a discontinued SKU stays
/// queryable (existing orders/inventory history still reference it) but can
/// never be reactivated for sale the way a merely-inactive one can.
enum SkuStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED

  @@schema("catalog")
}

enum CollectionType {
  MANUAL
  DYNAMIC

  @@schema("catalog")
}

/// Storage abstraction (ADR-005 decision 3) — the catalog domain never
/// imports a specific object-storage SDK; swapping providers is a new value
/// here plus a new infrastructure/storage adapter, not a schema change.
enum MediaProvider {
  LOCAL
  S3
  CDN

  @@schema("catalog")
}

enum MediaKind {
  IMAGE
  VIDEO
  MODEL_3D
  AR_ASSET

  @@schema("catalog")
}

enum MediaRole {
  PRIMARY
  GALLERY
  THUMBNAIL
  SWATCH
  VIDEO
  MODEL_3D

  @@schema("catalog")
}

enum MediaStatus {
  ACTIVE
  ARCHIVED

  @@schema("catalog")
}

model Brand {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  slug          String        @unique
  /// `{ "fa": "...", "en": "..." }` — see ADR-005 decision 3.
  localizedName Json?         @map("localized_name")
  description   String?
  logoMediaId   String?       @map("logo_media_id") @db.Uuid
  status        CatalogStatus @default(ACTIVE)
  sortOrder     Int           @default(0) @map("sort_order")
  /// title/metaDescription/canonicalUrl/ogImage/noIndex — see ADR-005 decision 3.
  seo           Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  logoMedia Media?    @relation("BrandLogo", fields: [logoMediaId], references: [id])
  products  Product[]

  @@index([status])
  @@map("brands")
  @@schema("catalog")
}

/// Self-referencing tree, unlimited depth (blueprint §10). `status` is the
/// active/inactive switch; `publishedAt` is the separate "is this browsable
/// on the storefront" gate the brief asks for (null = not published).
model Category {
  id            String        @id @default(uuid()) @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  name          String
  slug          String        @unique
  localizedName Json?         @map("localized_name")
  description   String?
  imageMediaId  String?       @map("image_media_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  status        CatalogStatus @default(ACTIVE)
  publishedAt   DateTime?     @map("published_at")
  seo           Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  parent     Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryToParent")
  imageMedia Media?     @relation("CategoryImage", fields: [imageMediaId], references: [id])
  products   Product[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
  @@schema("catalog")
}

/// Manual (explicit `CollectionProduct` membership) or dynamic (`rules`
/// evaluated at query time by CollectionRuleEvaluator — see ADR-005 decision
/// 4; not a general rule engine, a fixed filter shape).
model Collection {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  localizedName Json?          @map("localized_name")
  description   String?
  type          CollectionType @default(MANUAL)
  /// Only read when type = DYNAMIC: `{ brandId?, categoryId?, tags?, gender?, productType? }`.
  rules         Json?
  priority      Int            @default(0)
  startAt       DateTime?      @map("start_at")
  endAt         DateTime?      @map("end_at")
  status        CatalogStatus  @default(ACTIVE)
  publishedAt   DateTime?      @map("published_at")
  imageMediaId  String?        @map("image_media_id") @db.Uuid
  seo           Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  imageMedia Media?              @relation("CollectionImage", fields: [imageMediaId], references: [id])
  products   CollectionProduct[]

  @@index([type])
  @@index([status])
  @@map("collections")
  @@schema("catalog")
}

/// MANUAL collection membership, with its own admin-controlled sort order
/// independent of the product's own catalog position.
model CollectionProduct {
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
  @@schema("catalog")
}

/// The merchandising aggregate root. Not itself sellable/priced/inventoried
/// — see ProductVariant/ProductSku below (ADR-005 decision 1). Status is
/// ProductLifecycleStatus, driven only through ProductLifecycleStateMachine.
model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  productType       ProductType            @map("product_type")
  brandId           String                 @map("brand_id") @db.Uuid
  categoryId        String                 @map("category_id") @db.Uuid
  name              String
  slug              String                 @unique
  localizedName     Json?                  @map("localized_name")
  shortDescription  String?                @map("short_description")
  longDescription   String?                @map("long_description")
  /// Free-form spec sheet (varies hugely by productType — frame vs. contact
  /// lens), e.g. `{ "lensWidth": "52mm", "material": "acetate" }`.
  specifications    Json?
  tags              String[]               @default([])
  status            ProductLifecycleStatus @default(DRAFT)
  reviewedBy        String?                @map("reviewed_by") @db.Uuid
  approvedBy        String?                @map("approved_by") @db.Uuid
  approvedAt        DateTime?              @map("approved_at")
  publishedAt       DateTime?              @map("published_at")
  unpublishedAt     DateTime?              @map("unpublished_at")
  archivedAt        DateTime?              @map("archived_at")
  /// AR-readiness (Phase 005 `ar_readiness` — schema only, no AR engine).
  arModelMediaId    String?                @map("ar_model_media_id") @db.Uuid
  faceTryOnMetadata Json?                  @map("face_try_on_metadata")
  seo               Json?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")

  brand        Brand               @relation(fields: [brandId], references: [id])
  category     Category            @relation(fields: [categoryId], references: [id])
  arModelMedia Media?              @relation("ProductArModel", fields: [arModelMediaId], references: [id])
  variants     ProductVariant[]
  skus         ProductSku[]
  media        ProductMedia[]
  collections  CollectionProduct[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([productType])
  @@map("products")
  @@schema("catalog")
}

/// One product, many merchandising configurations (e.g. color × size —
/// blueprint §8). Carries the optical measurement/merchandising attributes;
/// deliberately has no price/cost/barcode — see ProductSku and ADR-005
/// decision 1. A variant can exist without a SKU yet (draft authoring
/// workflow); it cannot be sold until one exists.
model ProductVariant {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  label             String?
  color             String?
  colorHex          String?        @map("color_hex")
  size              String?
  frameShape        String?        @map("frame_shape")
  frameMaterial     String?        @map("frame_material")
  frameWidthMm      Int?           @map("frame_width_mm")
  bridgeWidthMm     Int?           @map("bridge_width_mm")
  templeLengthMm    Int?           @map("temple_length_mm")
  lensWidthMm       Int?           @map("lens_width_mm")
  fit               String?
  gender            ProductGender?
  style             String?
  /// Tag references into LensType.name / LensCoating.name — not an FK
  /// (a variant can list compatibility with lens options that are still
  /// lookup-table rows, see LensType's own doc comment).
  lensCompatibility String[]       @default([]) @map("lens_compatibility")
  isDefault         Boolean        @default(false) @map("is_default")
  status            CatalogStatus  @default(ACTIVE)
  sortOrder         Int            @default(0) @map("sort_order")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  product         Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             ProductSku?
  media           ProductMedia[]
  attributeValues ProductVariantAttributeValue[]

  @@index([productId])
  @@map("product_variants")
  @@schema("catalog")
}

/// The sellable/priced/inventoried unit (ADR-005 decision 1). Exactly one
/// SKU per variant this pass (`variantId` unique) — see that ADR's
/// "Deferred" section for why multi-SKU-per-variant isn't built yet. Cost
/// and base/compare-at price deliberately live on `finance.ProductPrice`,
/// not here — "pricing is its own domain, not a bare column" (that model's
/// own doc comment) applies to SKU exactly as it did to the old
/// `ProductVariant`. `finance.ProductPrice`/`PriceHistory` and
/// `inventory.InventoryItem` key off `id` here (as a plain, unenforced
/// cross-schema column — see docs/database/README.md's "Cross-schema
/// references are intentionally unenforced").
model ProductSku {
  id                 String    @id @default(uuid()) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  variantId          String    @unique @map("variant_id") @db.Uuid
  skuCode            String    @unique @map("sku_code")
  barcode            String?   @unique
  status             SkuStatus @default(ACTIVE)
  weightGrams        Int?      @map("weight_grams")
  lengthMm           Int?      @map("length_mm")
  widthMm            Int?      @map("width_mm")
  heightMm           Int?      @map("height_mm")
  /// Integer basis points (e.g. 900 = 9.00%) — same convention as
  /// `packages/types`' `Money.applyBasisPoints`, never a float.
  taxRateBasisPoints Int?      @map("tax_rate_basis_points")
  supplierRef        String?   @map("supplier_ref")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("product_skus")
  @@schema("catalog")
}

/// Attribute *definitions* (blueprint §9/§11: admin-defined, drives the
/// Dynamic Filter Engine without a Frontend/Backend redeploy) — for
/// open-ended tags the fixed ProductVariant columns don't cover.
model ProductAttribute {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique // e.g. "frame_shape"
  name          String // e.g. "شکل فریم"
  localizedName Json?    @map("localized_name")
  isFilterable  Boolean  @default(true) @map("is_filterable")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  values ProductAttributeValue[]

  @@map("product_attributes")
  @@schema("catalog")
}

model ProductAttributeValue {
  id             String   @id @default(uuid()) @db.Uuid
  attributeId    String   @map("attribute_id") @db.Uuid
  value          String // e.g. "Round"
  localizedValue Json?    @map("localized_value")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  attribute ProductAttribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("product_attribute_values")
  @@schema("catalog")
}

model ProductVariantAttributeValue {
  variantId        String   @map("variant_id") @db.Uuid
  attributeValueId String   @map("attribute_value_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attribute_values")
  @@schema("catalog")
}

/// Storage-agnostic media asset (ADR-005 decision 3). `provider` +
/// `storageKey` are the abstraction seam; nothing in this domain imports an
/// S3/CDN SDK directly. `kind = MODEL_3D | AR_ASSET` is the AR-readiness
/// hook (`Product.arModelMediaId`) — no AR engine reads it yet.
model Media {
  id         String        @id @default(uuid()) @db.Uuid
  provider   MediaProvider @default(LOCAL)
  storageKey String        @unique @map("storage_key")
  url        String
  kind       MediaKind
  mimeType   String        @map("mime_type")
  width      Int?
  height     Int?
  durationMs Int?          @map("duration_ms")
  checksum   String?
  altText    Json?         @map("alt_text")
  status     MediaStatus   @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  brandLogos       Brand[]        @relation("BrandLogo")
  categoryImages   Category[]     @relation("CategoryImage")
  collectionImages Collection[]   @relation("CollectionImage")
  arModelProducts  Product[]      @relation("ProductArModel")
  productMedia     ProductMedia[]

  @@index([kind])
  @@index([status])
  @@map("media")
  @@schema("catalog")
}

/// Attaches a Media asset to a product (`variantId = null`) or to one
/// specific variant (e.g. a colorway's own gallery). `onDelete: Restrict` on
/// `media` — a Media row in active use can't be silently deleted out from
/// under a product; it must be detached first (see Media's own doc comment).
model ProductMedia {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  variantId       String?   @map("variant_id") @db.Uuid
  mediaId         String    @map("media_id") @db.Uuid
  role            MediaRole @default(GALLERY)
  sortOrder       Int       @default(0) @map("sort_order")
  altTextOverride Json?     @map("alt_text_override")
  createdAt       DateTime  @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_media")
  @@schema("catalog")
}

/// blueprint §13 — minimal lookup tables only. The full lens configuration +
/// compatibility engine (index, coating combinations, pricing rules) is
/// deliberately out of scope for this foundation pass (still true as of
/// Phase 005 — see ADR-005 "Deferred").
model LensType {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  localizedName Json?    @map("localized_name")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("lens_types")
  @@schema("catalog")
}

model LensCoating {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  localizedName Json?    @map("localized_name")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("lens_coatings")
  @@schema("catalog")
}

// =============================================================================
// inventory — warehouses, stock ledger, reservations (blueprint §23-§28)
// =============================================================================

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED

  @@schema("inventory")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  address   String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventoryItem[]

  @@map("warehouses")
  @@schema("inventory")
}

/// blueprint §23 — stock/reserved/available are tracked explicitly;
/// `available` is computed (stock - reserved), never stored redundantly.
/// `productSkuId` (Phase 005 — was `productVariantId`; see ADR-005 decision
/// 1) is a plain, unenforced cross-schema column into `catalog.product_skus`
/// — see docs/database/README.md's "Cross-schema references are
/// intentionally unenforced".
model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productSkuId     String   @map("product_sku_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  reorderPoint     Int?     @map("reorder_point")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  transactions InventoryTransaction[]
  reservations StockReservation[]

  @@unique([warehouseId, productSkuId])
  @@index([productSkuId])
  @@map("inventory_items")
  @@schema("inventory")
}

/// blueprint §24/§27 — the ledger. `quantityOnHand` above is a maintained
/// cache of the sum of these; this table is the source of truth for *why*.
model InventoryTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  inventoryItemId String                   @map("inventory_item_id") @db.Uuid
  type            InventoryTransactionType
  quantityDelta   Int                      @map("quantity_delta")
  reference       String? // e.g. an order id, a transfer id — not an FK, deliberately polymorphic
  note            String?
  createdBy       String?                  @map("created_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@map("inventory_transactions")
  @@schema("inventory")
}

model StockReservation {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @map("inventory_item_id") @db.Uuid
  orderId         String?           @map("order_id") @db.Uuid
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime?         @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([orderId])
  @@map("stock_reservations")
  @@schema("inventory")
}

// =============================================================================
// commerce — cart, checkout, orders, payments (blueprint §16-§19, §24-§25)
// =============================================================================

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@schema("commerce")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@schema("commerce")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED

  @@schema("commerce")
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String?    @map("customer_id") @db.Uuid // nullable — guest checkout (blueprint §115)
  sessionToken String?    @unique @map("session_token")
  status       CartStatus @default(ACTIVE)
  currency     String     @default("IRR")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  items CartItem[]

  @@index([customerId])
  @@map("carts")
  @@schema("commerce")
}

/// `productSkuId` (Phase 005 — was `productVariantId`; see ADR-005 decision 1).
model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  cartId            String   @map("cart_id") @db.Uuid
  productSkuId      String   @map("product_sku_id") @db.Uuid
  quantity          Int
  unitPriceSnapshot BigInt   @map("unit_price_snapshot")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productSkuId])
  @@map("cart_items")
  @@schema("commerce")
}

/// blueprint §17/§25 — Order ≠ live Product: every price/name/sku field an
/// order needs is snapshotted at creation (on OrderItem), never re-read from
/// the live catalog. Status transitions are recorded in OrderStatusHistory,
/// never silently overwritten.
model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  orderNumber             String      @unique @map("order_number")
  customerId              String      @map("customer_id") @db.Uuid
  status                  OrderStatus @default(CREATED)
  currency                String      @default("IRR")
  subtotal                BigInt
  discountTotal           BigInt      @default(0) @map("discount_total")
  taxTotal                BigInt      @default(0) @map("tax_total")
  shippingTotal           BigInt      @default(0) @map("shipping_total")
  grandTotal              BigInt      @map("grand_total")
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?       @map("billing_address_snapshot")
  placedAt                DateTime    @default(now()) @map("placed_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  deletedAt               DateTime?   @map("deleted_at")

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
  @@schema("commerce")
}

/// `productSkuId` (Phase 005 — was `productVariantId`; see ADR-005 decision 1).
model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productSkuId      String?  @map("product_sku_id") @db.Uuid // nullable: the SKU may later be deleted; snapshot fields below carry the truth regardless
  skuSnapshot       String   @map("sku_snapshot")
  nameSnapshot      String   @map("name_snapshot")
  unitPriceSnapshot BigInt   @map("unit_price_snapshot")
  quantity          Int
  lineTotal         BigInt   @map("line_total")
  createdAt         DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
  @@schema("commerce")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
  @@schema("commerce")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  provider       String // adapter name, e.g. "zarinpal" — see docs/product/blueprint.md §75
  status         PaymentStatus @default(PENDING)
  amount         BigInt
  currency       String        @default("IRR")
  transactionRef String?       @map("transaction_ref")
  idempotencyKey String?       @unique @map("idempotency_key") // blueprint §67 — one payment per key, no double-charges on retry
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
  @@schema("commerce")
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amount      BigInt
  reason      String?
  status      RefundStatus @default(PENDING)
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
  @@schema("commerce")
}

// =============================================================================
// marketing — coupons, promotions, campaigns (blueprint §33-§37, §69)
// =============================================================================

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT

  @@schema("marketing")
}

enum CampaignChannel {
  SMS
  EMAIL
  PUSH
  IN_APP

  @@schema("marketing")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED

  @@schema("marketing")
}

model Coupon {
  id                String     @id @default(uuid()) @db.Uuid
  code              String     @unique
  type              CouponType
  value             BigInt // percentage (0-10000 basis points) or a Rial amount, per `type`
  minOrderAmount    BigInt?    @map("min_order_amount")
  maxDiscountAmount BigInt?    @map("max_discount_amount")
  usageLimit        Int?       @map("usage_limit")
  perUserLimit      Int?       @map("per_user_limit")
  startsAt          DateTime?  @map("starts_at")
  endsAt            DateTime?  @map("ends_at")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  redemptions CouponRedemption[]

  @@map("coupons")
  @@schema("marketing")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  discountAmount BigInt   @map("discount_amount")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
  @@map("coupon_redemptions")
  @@schema("marketing")
}

/// blueprint §14 — a basic, ruleless promotion (all-or-nothing % or fixed
/// off, scoped to specific products). The full condition/rule engine
/// (customer segment + category + cart-total conditions) is future work.
model Promotion {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  discountType  CouponType @map("discount_type")
  discountValue BigInt     @map("discount_value")
  startsAt      DateTime   @map("starts_at")
  endsAt        DateTime   @map("ends_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  products PromotionProduct[]

  @@map("promotions")
  @@schema("marketing")
}

model PromotionProduct {
  promotionId String   @map("promotion_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
  @@schema("marketing")
}

model Campaign {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  key         String          @unique
  channel     CampaignChannel
  status      CampaignStatus  @default(DRAFT)
  scheduledAt DateTime?       @map("scheduled_at")
  startedAt   DateTime?       @map("started_at")
  endedAt     DateTime?       @map("ended_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("campaigns")
  @@schema("marketing")
}

// =============================================================================
// cms — pages, content, navigation (blueprint §45-§49)
// =============================================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("cms")
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  sections PageSection[]

  @@map("pages")
  @@schema("cms")
}

/// blueprint §46 — `type` + `config` (JSON) is the Section Builder: new
/// section types are data, not a schema migration or a frontend redeploy.
model PageSection {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  type      String // "Hero" | "ProductCarousel" | "Banner" | ...
  sortOrder Int      @default(0) @map("sort_order")
  config    Json
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_sections")
  @@schema("cms")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  placement String // "HOME_HERO" | "CATEGORY_TOP" | ... — free-form, admin-managed
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
  @@schema("cms")
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  title         String
  excerpt       String?
  contentHtml   String        @map("content_html")
  coverImageUrl String?       @map("cover_image_url")
  authorId      String?       @map("author_id") @db.Uuid
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  @@map("articles")
  @@schema("cms")
}

model Menu {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // "header" | "footer" | ...
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@map("menus")
  @@schema("cms")
}

model MenuItem {
  id        String   @id @default(uuid()) @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  label     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemToParent", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemToParent")

  @@index([menuId])
  @@map("menu_items")
  @@schema("cms")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
  @@schema("cms")
}

// =============================================================================
// finance — pricing (kept independent of catalog per blueprint §12), price
// history, invoices (blueprint §12-§13, §39)
// =============================================================================

/// blueprint §12 — Pricing is its own domain, not a bare column on Product.
/// Exactly one active price row per SKU; changes go through PriceHistory,
/// never a silent overwrite. `productSkuId` (Phase 005 — was
/// `productVariantId`; see ADR-005 decision 1) stays a plain, unenforced
/// cross-schema column into `catalog.product_skus`. `compareAtPrice` +
/// `validFrom`/`validTo` are Phase 005's scheduled-pricing foundation —
/// `validFrom`/`validTo` describe *this row's* effective window; a future
/// scheduled price change is a new row that isn't active yet, resolved by
/// the application layer picking the row whose window contains "now", not a
/// cron job mutating `basePrice` in place.
model ProductPrice {
  id             String    @id @default(uuid()) @db.Uuid
  productSkuId   String    @unique @map("product_sku_id") @db.Uuid
  basePrice      BigInt    @map("base_price")
  compareAtPrice BigInt?   @map("compare_at_price")
  costPrice      BigInt?   @map("cost_price")
  currency       String    @default("IRR")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("product_prices")
  @@schema("finance")
}

/// blueprint §13 — append-only, mirrors the exact example in the blueprint
/// (SKU, old price, new price, changed by, reason). `productSkuId` (Phase
/// 005 — was `productVariantId`).
model PriceHistory {
  id           String   @id @default(uuid()) @db.Uuid
  productSkuId String   @map("product_sku_id") @db.Uuid
  oldPrice     BigInt?  @map("old_price")
  newPrice     BigInt   @map("new_price")
  changedBy    String?  @map("changed_by") @db.Uuid
  reason       String?
  changedAt    DateTime @default(now()) @map("changed_at")

  @@index([productSkuId])
  @@map("price_history")
  @@schema("finance")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number")
  issuedAt      DateTime @default(now()) @map("issued_at")
  subtotal      BigInt
  taxTotal      BigInt   @default(0) @map("tax_total")
  grandTotal    BigInt   @map("grand_total")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  lines InvoiceLine[]

  @@map("invoices")
  @@schema("finance")
}

model InvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  lineTotal   BigInt @map("line_total")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
  @@schema("finance")
}

// =============================================================================
// notification — templates, delivery log, per-customer channel consent
// (blueprint §38-§44, §75)
// =============================================================================

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED

  @@schema("notification")
}

/// blueprint §44 — `body` holds `{{variable}}` placeholders; admin-editable,
/// no code deploy needed to change copy.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @unique // "ORDER_CREATED", "OTP", ...
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  logs NotificationLog[]

  @@map("notification_templates")
  @@schema("notification")
}

model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  templateId   String?             @map("template_id") @db.Uuid
  channel      NotificationChannel
  recipient    String
  customerId   String?             @map("customer_id") @db.Uuid
  status       NotificationStatus  @default(QUEUED)
  providerRef  String?             @map("provider_ref")
  errorMessage String?             @map("error_message")
  sentAt       DateTime?           @map("sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("notification_logs")
  @@schema("notification")
}

/// blueprint §75 — explicit per-channel consent, checked before every send.
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @unique @map("customer_id") @db.Uuid
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  whatsappEnabled Boolean  @default(true) @map("whatsapp_enabled")
  telegramEnabled Boolean  @default(true) @map("telegram_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
  @@schema("notification")
}

// =============================================================================
// analytics — event capture (blueprint §67-§68)
// =============================================================================

/// One generic, append-only event table rather than a bespoke table per
/// event type — `eventType` + `metadata` (JSON) covers product views,
/// searches, filters, cart actions, etc. Promote a specific event type to
/// its own structured table only once it needs real relational querying.
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") // "PRODUCT_VIEW" | "SEARCH" | "ADD_TO_CART" | ...
  customerId String?  @map("customer_id") @db.Uuid
  sessionId  String?  @map("session_id")
  productId  String?  @map("product_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType, occurredAt])
  @@index([customerId])
  @@map("analytics_events")
  @@schema("analytics")
}

// =============================================================================
// system — audit log, API keys, webhooks, feature flags, settings
// (blueprint §54-§55, §86-§87)
// =============================================================================

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("system")
}

/// blueprint §54 — the append-only "who changed what" record. Every
/// sensitive mutation (price change, role change, refund approval, ...)
/// should write one of these; nothing here is ever updated after insert.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorIp     String?  @map("actor_ip")
  actorDevice String?  @map("actor_device") // -> identity.user_devices.id, unenforced (see docs/database/README.md#cross-schema-references-are-intentionally-unenforced) — blueprint §54 lists "Device" alongside "IP" on every audit entry
  action      String // "PRODUCT_PRICE_CHANGED", "ROLE_ASSIGNED", ...
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
  @@schema("system")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  ownerId    String?   @map("owner_id") @db.Uuid
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("api_keys")
  @@schema("system")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@map("webhooks")
  @@schema("system")
}

model WebhookDelivery {
  id          String                @id @default(uuid()) @db.Uuid
  webhookId   String                @map("webhook_id") @db.Uuid
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempt     Int                   @default(1)
  respondedAt DateTime?             @map("responded_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
  @@schema("system")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("system")
}

/// blueprint §87 — generic key-value store for business settings (company
/// info, order/payment/shipping/SEO config, ...). `value` is JSON so the
/// shape is whatever that setting needs, not a fixed column set.
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("system")
}
